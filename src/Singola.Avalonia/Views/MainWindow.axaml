<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Singola.ViewModels"
        xmlns:controls="using:Singola.Avalonia.Controls"
        x:Class="Singola.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Singola" Width="900" Height="600" MinWidth="640" MinHeight="400">
  <Grid Margin="28" RowDefinitions="Auto,*">
    <TextBlock FontSize="30" FontWeight="Bold" Text="SINGOLA" />
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="18" Margin="0,20,0,0">
        <TextBlock FontSize="18" Text="{Binding SongStatus}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Choose song…" Click="ChooseSong_Click" />
          <Button Content="Start" Command="{Binding StartRoundCommand}" IsEnabled="{Binding CanStart}" />
          <Button Content="Pause / Resume" Command="{Binding TogglePauseCommand}" IsVisible="{Binding IsSinging}" />
          <Button Content="Stop" Command="{Binding StopRoundCommand}" IsVisible="{Binding IsSinging}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Add player" Command="{Binding AddPlayerCommand}" />
          <Button Content="Playlist" Command="{Binding CreatePlaylistCommand}" />
          <Button Content="Settings" Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Players}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="10" Margin="0,4" Background="#282434">
                <Grid ColumnDefinitions="*,220,Auto,Auto">
                  <TextBlock Text="{Binding Name}" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding InputDevice}" />
                  <TextBlock Grid.Column="2" Text="{Binding Score}" Margin="12,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Note}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Padding="12" Background="#201A2B">
          <StackPanel>
            <TextBlock FontWeight="Bold" Text="Lyrics" />
            <TextBlock Text="{Binding LyricPrev}" Opacity="0.6" />
            <TextBlock Text="{Binding LyricCurrent}" FontSize="20" />
            <TextBlock Text="{Binding LyricNext}" Opacity="0.6" />
            <TextBlock Text="{Binding TimeText}" />
          </StackPanel>
        </Border>
        <controls:KaraokeStage x:Name="Stage" Height="220"
                               IsVisible="{Binding IsSinging}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
