<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shared domain layer. Runtime-specific audio backends remain isolated behind hosts. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Audiola</RootNamespace>
    <!-- Die miniaudio-Callbacks arbeiten auf rohen Puffern (siehe Services/Audio). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUETools.Codecs.FLAKE" Version="1.0.5" />
    <PackageReference Include="JAJ.Packages.MiniAudioEx" Version="3.3.6" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <!-- Die Python-Sidecars gehören zu den Diensten hier (PythonLocalVoiceService,
       PythonAudioDetectorProbeProvider) und werden neben der Anwendung erwartet
       (AppContext.BaseDirectory). Als Content landen sie über die Projektverweise
       in jeder Ausgabe — vorher lagen sie nur im WPF-Projekt und fehlten der
       Avalonia-Fassung komplett. -->
  <ItemGroup>
    <Content Include="voicebox_engine.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="audio_detector_probe.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
