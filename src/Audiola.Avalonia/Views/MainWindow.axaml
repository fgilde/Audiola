<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:controls="using:Audiola.Controls"
        xmlns:vm="using:Audiola.ViewModels"
        x:Class="Audiola.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding ApplicationTitle}"
        Width="1360" Height="820"
        MinWidth="980" MinHeight="640"
        Background="{DynamicResource DawBgBrush}"
        Foreground="{DynamicResource DawTextBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Audiola/Assets/audiola.png"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38">

  <!-- Port der WPF-Shell (Audiola/Views/MainWindow.xaml): Titelzeile, Transportleiste,
       Werkzeug-Rail, Arbeitsfläche, Statusleiste. Aktionen liegen im geteilten
       MainWindowViewModel; hier nur Layout + Fensterereignisse. -->

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ============ TITELZEILE (überlagert die Fensterdekoration) ============ -->
    <Grid Grid.Row="0" Height="38" Background="{DynamicResource DawBgBrush}">
      <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="8">
        <Image Source="avares://Audiola/Assets/audiola.png" Width="16" Height="16" />
        <TextBlock Text="{Binding ApplicationTitle}" FontSize="12"
                   Foreground="{DynamicResource DawTextDimBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- ============ TRANSPORT-LEISTE (immer sichtbar) ============ -->
    <Border Grid.Row="1" Background="{DynamicResource DawPanelBrush}"
            BorderBrush="{DynamicResource DawStrokeBrush}" BorderThickness="0,1" Padding="8,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- Menü (kompakt) -->
        <Menu Grid.Column="0" VerticalAlignment="Center">
          <MenuItem Header="_Datei">
            <MenuItem Header="Öffnen… (Audio/ZIP)" InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
            <MenuItem Header="Audio ins Studio hinzufügen…" Command="{Binding AddToStudioCommand}" />
            <Separator />
            <MenuItem Header="Projekt öffnen…" Command="{Binding OpenProjectCommand}" />
            <MenuItem Header="Letzte Projekte" ItemsSource="{Binding Home.RecentProjects}"
                      IsEnabled="{Binding Home.HasRecentProjects}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                              x:DataType="vm:RecentItem">
                  <Setter Property="Header" Value="{Binding Name}" />
                  <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
                  <Setter Property="Command"
                          Value="{ReflectionBinding $parent[Window].DataContext.OpenRecentCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
            <MenuItem Header="Letzte Dateien" ItemsSource="{Binding Home.RecentFiles}"
                      IsEnabled="{Binding Home.HasRecent}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                              x:DataType="vm:RecentItem">
                  <Setter Property="Header" Value="{Binding Name}" />
                  <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
                  <Setter Property="Command"
                          Value="{ReflectionBinding $parent[Window].DataContext.OpenRecentCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
            <Separator />
            <MenuItem Header="Projekt speichern" InputGesture="Ctrl+S" Command="{Binding SaveProjectCommand}"
                      IsEnabled="{Binding Transport.HasTrack}" />
            <MenuItem Header="Projekt speichern unter…" InputGesture="Ctrl+Shift+S"
                      Command="{Binding SaveProjectAsCommand}" IsEnabled="{Binding Transport.HasTrack}" />
            <MenuItem Header="Projekt schließen" Command="{Binding CloseProjectCommand}"
                      IsEnabled="{Binding Transport.HasTrack}" />
            <Separator />
            <MenuItem Header="Beenden" Click="Exit_Click" />
          </MenuItem>
          <MenuItem Header="_Hilfe">
            <MenuItem Header="Einrichtungs-Assistent…" Command="{Binding ShowSetupWizardCommand}" />
            <MenuItem Header="Mess-Harness" Command="{Binding NavigateCommand}" CommandParameter="Evaluation" />
            <Separator />
            <MenuItem Header="Nach Updates suchen…" Command="{Binding CheckUpdatesCommand}" />
            <Separator />
            <MenuItem Header="Über Audiola" Command="{Binding NavigateCommand}" CommandParameter="About" />
          </MenuItem>
        </Menu>

        <!-- Play / Stop -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="6">
          <Button Width="46" Height="34" Classes="accent" ToolTip.Tip="Abspielen / Pause"
                  Command="{Binding Transport.PlayPauseCommand}" IsEnabled="{Binding Transport.HasTrack}">
            <ic:SymbolIcon Symbol="Play" FontSize="18" />
          </Button>
          <Button Width="42" Height="34" ToolTip.Tip="Stopp"
                  Command="{Binding Transport.StopCommand}" IsEnabled="{Binding Transport.HasTrack}">
            <ic:SymbolIcon Symbol="Stop" FontSize="18" />
          </Button>
        </StackPanel>

        <!-- Zeitanzeige -->
        <Border Grid.Column="2" Margin="14,0,0,0" Padding="12,3" CornerRadius="6"
                Background="{DynamicResource DawBgBrush}" BorderBrush="{DynamicResource DawStrokeBrush}"
                BorderThickness="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="dawTimeDisplay" Text="{Binding Transport.PositionText}" />
            <TextBlock Classes="dawTimeDisplay" Margin="6,0"
                       Foreground="{DynamicResource DawTextFaintBrush}" Text="/" />
            <TextBlock Classes="dawTimeDisplay"
                       Foreground="{DynamicResource DawTextDimBrush}" Text="{Binding Transport.DurationText}" />
          </StackPanel>
        </Border>

        <!-- Mix-Wellenform (klickbar zum Springen) -->
        <controls:WaveformControl Grid.Column="3" Name="TransportWaveform"
                                  Height="34" Margin="14,0" VerticalAlignment="Center" Cursor="Hand"
                                  PointerPressed="Transport_WaveformPointerPressed"
                                  Peaks="{Binding Transport.Peaks}"
                                  Progress="{Binding Transport.Progress}" />

        <!-- Echtzeit-Spektrum -->
        <controls:SpectrumControl Grid.Column="4" Name="Spectrum"
                                  Width="170" Height="30" Margin="0,0,14,0" VerticalAlignment="Center" />

        <!-- Master-Pegel (VU) + Lautstärke -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
          <controls:LevelMeterControl Name="LevelMeter" Width="46" Height="24" Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
          <ic:SymbolIcon Symbol="Speaker2" VerticalAlignment="Center"
                         Foreground="{DynamicResource DawTextDimBrush}" />
          <Slider Width="92" Margin="8,0,0,0" VerticalAlignment="Center"
                  Minimum="0" Maximum="1" Value="{Binding Transport.Volume, Mode=TwoWay}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ HAUPTBEREICH: Rail + Arbeitsfläche ============ -->
    <Grid Grid.Row="2" ColumnDefinitions="52,*">

      <!-- Werkzeug-Rail -->
      <Border Grid.Column="0" Background="{DynamicResource DawPanelBrush}"
              BorderBrush="{DynamicResource DawStrokeBrush}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="False">
          <StackPanel Name="RailItems" DockPanel.Dock="Top" Margin="0,6,0,0">
            <RadioButton Classes="dawRail" GroupName="Rail" IsChecked="True" Tag="Home" Click="Nav_Click"
                         ToolTip.Tip="Start — Projekte &amp; zuletzt geöffnet">
              <ic:SymbolIcon Symbol="Home" FontSize="19" />
            </RadioButton>
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="Timeline" Click="Nav_Click"
                         ToolTip.Tip="Studio (Timeline)">
              <ic:SymbolIcon Symbol="Timeline" FontSize="19" />
            </RadioButton>
            <Rectangle Height="1" Margin="12,6" Fill="{DynamicResource DawStrokeBrush}" />
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="Equalizer" Click="Nav_Click"
                         ToolTip.Tip="Equalizer">
              <ic:SymbolIcon Symbol="Options" FontSize="19" />
            </RadioButton>
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="Mastering" Click="Nav_Click"
                         ToolTip.Tip="Mastering">
              <ic:SymbolIcon Symbol="SoundWaveCircle" FontSize="19" />
            </RadioButton>
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="SpatialAudio" Click="Nav_Click"
                         ToolTip.Tip="Spatial Audio (3D)">
              <ic:SymbolIcon Symbol="Headphones" FontSize="19" />
            </RadioButton>
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="Voices" Click="Nav_Click"
                         ToolTip.Tip="Stimmen (TTS &amp; Klonen)">
              <ic:SymbolIcon Symbol="PersonVoice" FontSize="19" />
            </RadioButton>
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="Metadata" Click="Nav_Click"
                         ToolTip.Tip="Metadaten &amp; Tags">
              <ic:SymbolIcon Symbol="Tag" FontSize="19" />
            </RadioButton>
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="Variation" Click="Nav_Click"
                         ToolTip.Tip="Klangvariation (Studio-Effekte)">
              <ic:SymbolIcon Symbol="Pulse" FontSize="19" />
            </RadioButton>
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="Provenance" Click="Nav_Click"
                         ToolTip.Tip="Provenienz-Analyse">
              <ic:SymbolIcon Symbol="DocumentSearch" FontSize="19" />
            </RadioButton>
          </StackPanel>
          <StackPanel Name="RailFooter" DockPanel.Dock="Bottom" Margin="0,0,0,8">
            <Rectangle Height="1" Margin="12,6" Fill="{DynamicResource DawStrokeBrush}" />
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="Settings" Click="Nav_Click"
                         ToolTip.Tip="Einstellungen">
              <ic:SymbolIcon Symbol="Settings" FontSize="19" />
            </RadioButton>
            <RadioButton Classes="dawRail" GroupName="Rail" Tag="About" Click="Nav_Click"
                         ToolTip.Tip="Über Audiola">
              <ic:SymbolIcon Symbol="Info" FontSize="19" />
            </RadioButton>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Arbeitsfläche: die Navigation tauscht hier die Seite. -->
      <ContentControl Grid.Column="1" Name="PageHost" Background="Transparent" />
    </Grid>

    <!-- ============ STATUSLEISTE ============ -->
    <Border Grid.Row="3" Background="{DynamicResource DawPanelBrush}"
            BorderBrush="{DynamicResource DawStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Name="StatusDot"
                   Fill="{DynamicResource DawGreenBrush}" />
          <TextBlock Classes="dawStatusText" Margin="7,0,0,0" Text="{Binding Status}" />
          <TextBlock Classes="dawStatusText" Margin="18,0,0,0" Text="{Binding Transport.TrackName}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="dawStatusText" Text="{Binding ApplicationTitle}" />
      </Grid>
    </Border>

    <!-- Toasts liegen über Arbeitsfläche und Statusleiste. -->
    <controls:SnackbarHost Name="RootSnackbarHost" Grid.Row="2" Grid.RowSpan="2" />
  </Grid>

  <Window.Styles>
    <!-- Statuskugel wird gelb, solange eine Hintergrund-Aufgabe läuft. -->
    <Style Selector="Ellipse#StatusDot.working">
      <Setter Property="Fill" Value="{DynamicResource DawYellowBrush}" />
    </Style>
  </Window.Styles>
</Window>
