<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Audiola.Avalonia.Views.Pages.PendingPage">

  <!-- Zwischenstand der Migration: diese Seite ist noch nicht aus der WPF-Fassung portiert. -->

  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="460">
    <ic:SymbolIcon Symbol="Wrench" FontSize="34" HorizontalAlignment="Center"
                   Foreground="{DynamicResource DawTextFaintBrush}" />
    <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
               Text="Diese Seite wird noch portiert" />
    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
               Foreground="{DynamicResource DawTextDimBrush}"
               Text="Die Windows-Fassung (WPF) hat sie schon; die plattformübergreifende Oberfläche holt sie gerade nach." />
  </StackPanel>
</UserControl>
