<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Audiola.ViewModels"
             x:Class="Audiola.Avalonia.Views.Pages.VariationPage"
             x:DataType="vm:VariationViewModel">

  <!-- Klangvariation: eine songnahe Variante ohne Tempo- oder Tonhöhen-Eingriff.
       Aufbau wie im Studio: Kopfzeile mit der primären Aktion rechts, darunter Presets als
       erklärte Karten, dann die Regler in zwei Spalten mit Wertanzeige. -->

  <UserControl.Styles>
    <!-- Preset-Karte: Icon, Name, ein Satz — statt dreier nackter Textknöpfe. -->
    <Style Selector="Button.presetCard">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.presetCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource DawAccentLightBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Margin="42,24,42,24" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1120" HorizontalAlignment="Left">

      <!-- ═══ Kopfzeile ═══ -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Classes="dawPageTitle" Text="Klangvariation" />
          <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{Binding Session.CurrentTrack.FileName, FallbackValue='Keine Datei geladen', TargetNullValue='Keine Datei geladen'}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
          <ProgressBar Width="60" VerticalAlignment="Center" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
          <Button Classes="accent" Command="{Binding ExportCommand}"
                  ToolTip.Tip="Die Variante mit den aktuellen Einstellungen als Audiodatei speichern — das Original bleibt unverändert">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="Save" /><TextBlock Text="Variante exportieren" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="Erzeugt eine songnahe Variante: kleine Änderungen an Klang, Stereobild und Textur — ohne Eingriff in Tempo oder Tonhöhe. Die Originaldatei bleibt unverändert." />

      <!-- ═══ Presets: ein Klick setzt alle Regler ═══ -->
      <TextBlock Classes="sectionCaption" Margin="2,24,0,8" Text="PRESETS — setzen alle Regler auf einen Schlag" />
      <UniformGrid Columns="3">
        <Button Classes="presetCard" Margin="0,0,10,0" Command="{Binding ApplySubtlePresetCommand}"
                ToolTip.Tip="Kaum hörbar — für Varianten, die dem Original sehr nahe bleiben sollen">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:SymbolIcon Symbol="WeatherMoon" Foreground="{DynamicResource DawAccentLightBrush}" />
              <TextBlock FontWeight="SemiBold" Text="Subtil" />
            </StackPanel>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Kaum hörbar. Bleibt dem Original sehr nah." />
          </StackPanel>
        </Button>
        <Button Classes="presetCard" Margin="0,0,10,0" Command="{Binding ApplyBalancedPresetCommand}"
                ToolTip.Tip="Der Mittelweg — spürbar anders, aber unverkennbar derselbe Song">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:SymbolIcon Symbol="WeatherPartlyCloudyDay" Foreground="{DynamicResource DawAccentLightBrush}" />
              <TextBlock FontWeight="SemiBold" Text="Ausgewogen" />
            </StackPanel>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Spürbar anders, unverkennbar derselbe Song." />
          </StackPanel>
        </Button>
        <Button Classes="presetCard" Command="{Binding ApplyStrongerPresetCommand}"
                ToolTip.Tip="Deutlicher Eingriff — eigener Charakter, ohne Tempo und Tonhöhe anzutasten">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:SymbolIcon Symbol="WeatherSunny" Foreground="{DynamicResource DawAccentLightBrush}" />
              <TextBlock FontWeight="SemiBold" Text="Kräftiger" />
            </StackPanel>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Deutlicher Eingriff mit eigenem Charakter." />
          </StackPanel>
        </Button>
      </UniformGrid>

      <!-- ═══ Regler in zwei Spalten, Wert rechts neben dem Namen ═══ -->
      <Grid Margin="0,24,0,0" ColumnDefinitions="*,20,*">

        <StackPanel Grid.Column="0" Spacing="14">
          <TextBlock Classes="sectionCaption" Text="GESAMTWIRKUNG" />
          <Border Classes="dawPanel" Padding="16">
            <StackPanel Spacing="6">
              <Grid Classes="sliderRow" ColumnDefinitions="*,Auto">
                <TextBlock Text="Stärke" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding OverallStrength, StringFormat='{}{0:F0} %'}" />
              </Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding OverallStrength, Mode=TwoWay}"
                      ToolTip.Tip="Skaliert alle Eingriffe gemeinsam — 0 % ist das Original" />
              <CheckBox Margin="0,8,0,0" Content="Lautheit an das Original angleichen"
                        IsChecked="{Binding MatchInputLoudness, Mode=TwoWay}"
                        ToolTip.Tip="Die Variante wird so laut wie der Ausgangstrack, damit sich nur der Klang unterscheidet" />
            </StackPanel>
          </Border>

          <TextBlock Classes="sectionCaption" Margin="2,8,0,8" Text="KLANGFORMUNG" />
          <Border Classes="dawPanel" Padding="16">
            <StackPanel Spacing="6">
              <Grid Classes="sliderRow" ColumnDefinitions="*,Auto">
                <TextBlock Text="Klangneigung  ·  wärmer ↔ heller" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding TimbreShift, StringFormat='{}{0:+0;-0;0}'}" />
              </Grid>
              <Slider Minimum="-100" Maximum="100" Value="{Binding TimbreShift, Mode=TwoWay}" />
              <Grid Classes="sliderRow" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Text="Präsenz  ·  weicher ↔ direkter" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding PresenceShift, StringFormat='{}{0:+0;-0;0}'}" />
              </Grid>
              <Slider Minimum="-100" Maximum="100" Value="{Binding PresenceShift, Mode=TwoWay}" />
              <Grid Classes="sliderRow" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Text="Sättigung" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding Saturation, StringFormat='{}{0:F0} %'}" />
              </Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding Saturation, Mode=TwoWay}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="14">
          <TextBlock Classes="sectionCaption" Text="STEREO &amp; TEXTUR" />
          <Border Classes="dawPanel" Padding="16">
            <StackPanel Spacing="6">
              <Grid Classes="sliderRow" ColumnDefinitions="*,Auto">
                <TextBlock Text="Stereo-Breite  ·  enger ↔ weiter" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding StereoWidth, StringFormat='{}{0:+0;-0;0}'}" />
              </Grid>
              <Slider Minimum="-100" Maximum="100" Value="{Binding StereoWidth, Mode=TwoWay}" />
              <Grid Classes="sliderRow" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Text="Feinkorn" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding Texture, StringFormat='{}{0:F0} %'}" />
              </Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding Texture, Mode=TwoWay}"
                      ToolTip.Tip="Sehr feine Textur, die digitale Glätte aufbricht" />
            </StackPanel>
          </Border>

          <TextBlock Classes="sectionCaption" Margin="2,8,0,8" Text="ZUFALL" />
          <Border Classes="dawPanel" Padding="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding VariantSeed, StringFormat='Seed {0}'}"
                           FontFamily="Cascadia Mono, Consolas, monospace" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Derselbe Seed liefert bei gleichen Reglern dieselbe Variante." />
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding RandomizeSeedCommand}"
                      ToolTip.Tip="Neue Zufallsgrundlage — ergibt eine andere Variante mit denselben Reglern">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:SymbolIcon Symbol="ArrowShuffle" /><TextBlock Text="Neu würfeln" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12.5"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
