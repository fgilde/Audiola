<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Audiola.ViewModels"
             x:Class="Audiola.Avalonia.Views.Pages.EvaluationPage"
             x:DataType="vm:EvaluationViewModel">

  <!-- Port von Audiola/Views/Pages/EvaluationPage.xaml. -->

  <ScrollViewer Margin="42,24,42,24" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Classes="dawPageTitle" Text="Mess-Harness — Detektor-Zuverlässigkeit" />
      <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                 Text="Lädt eine gelabelte CSV (Wahrheit vs. Detektor-Urteil/Score) und berechnet Konfusionsmatrix und Kennzahlen. Positivklasse = „KI“. Reine Auswertung — es wird kein Detektor aufgerufen." />

      <!-- Aktionen -->
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button Classes="accent" Command="{Binding LoadCsvCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="DocumentTable" />
            <TextBlock Text="CSV laden" />
          </StackPanel>
        </Button>
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="620"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" Text="{Binding StatusText}" />
      </StackPanel>

      <!-- Schwellwert (nur bei Score-Spalte) -->
      <Border Margin="0,16,0,0" Padding="16" CornerRadius="8"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              IsVisible="{Binding HasScores}">
        <StackPanel>
          <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{Binding Threshold, StringFormat='Schwellwert (Score ≥ x ⇒ KI): {0:F2}'}" />
          <Slider Minimum="0" Maximum="1" Value="{Binding Threshold, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <!-- Ergebnisse -->
      <Grid Margin="0,16,0,0" ColumnDefinitions="Auto,*" IsVisible="{Binding HasResult}">

        <!-- Konfusionsmatrix -->
        <Border Grid.Column="0" Padding="16" CornerRadius="8" VerticalAlignment="Top"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Konfusionsmatrix" Margin="0,0,0,10" />
            <Grid ColumnDefinitions="110,110,110" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" FontSize="11"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Urteil: KI" />
              <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" FontSize="11"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Urteil: Mensch" />

              <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Wahr: KI" />
              <Border Grid.Row="1" Grid.Column="1" Margin="2" Padding="0,14" CornerRadius="6" Background="#3328A745">
                <StackPanel>
                  <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding TruePositives}" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="TP" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="2" Margin="2" Padding="0,14" CornerRadius="6" Background="#33FF6B6B">
                <StackPanel>
                  <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding FalseNegatives}" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="FN" />
                </StackPanel>
              </Border>

              <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Wahr: Mensch" />
              <Border Grid.Row="2" Grid.Column="1" Margin="2" Padding="0,14" CornerRadius="6" Background="#33FF6B6B">
                <StackPanel>
                  <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding FalsePositives}" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="FP" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="2" Margin="2" Padding="0,14" CornerRadius="6" Background="#3328A745">
                <StackPanel>
                  <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding TrueNegatives}" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="TN" />
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{Binding Total, StringFormat='n = {0} bewertet'}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{Binding Skipped, StringFormat='{}{0} Zeilen ohne Urteil übersprungen'}" />
          </StackPanel>
        </Border>

        <!-- Kennzahlen -->
        <Border Grid.Column="1" Margin="12,0,0,0" Padding="16" CornerRadius="8" VerticalAlignment="Top"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Kennzahlen" Margin="0,0,0,10" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,0,12">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Accuracy}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Accuracy (Treffergenauigkeit)" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding F1}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="F1-Score" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Recall}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Recall / TPR (KI erkannt)" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Precision}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Precision" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#FF8A8A" Text="{Binding FalsePositiveRate}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="False-Positive-Rate (Mensch → KI)" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#FF8A8A" Text="{Binding FalseNegativeRate}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="False-Negative-Rate (KI → Mensch)" />
              </StackPanel>
              <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Specificity}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Specificity / TNR" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
