<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:Audiola.Controls"
             xmlns:conv="using:Audiola.Avalonia.Converters"
             xmlns:models="using:Audiola.Models"
             xmlns:vm="using:Audiola.ViewModels"
             x:Class="Audiola.Avalonia.Views.Pages.EqualizerPage"
             x:DataType="vm:EqualizerViewModel">

  <!-- 4-Band-EQ. Aufbau wie im Studio: Kopfzeile mit der primären Aktion rechts, darunter die
       Werkzeugleiste in beschrifteten Gruppen, dann die Kurve als Hauptfläche. -->

  <UserControl.Resources>
    <conv:StringToBrushConverter x:Key="StringToBrush" />
  </UserControl.Resources>

  <Grid Margin="42,24,42,24" RowDefinitions="Auto,Auto,*,Auto">

    <!-- ═══ Kopfzeile ═══ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0">
        <TextBlock Classes="dawPageTitle" Text="Equalizer" />
        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Vier Bänder, direkt in der Kurve: Punkte ziehen ändert Frequenz und Pegel. Live im Studio-Mix hörbar oder als Datei exportieren." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
        <ProgressBar Width="60" VerticalAlignment="Center" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <Button Classes="accent" Command="{Binding ExportCommand}"
                ToolTip.Tip="Den Studio-Mix mit dieser EQ-Kurve als Audiodatei speichern (WAV/MP3/…)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="Save" /><TextBlock Text="Mix exportieren" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ═══ Werkzeugleiste ═══ -->
    <Border Grid.Row="1" Classes="toolbar">
      <WrapPanel Orientation="Horizontal">
        <Border Classes="toolGroup">
          <StackPanel>
            <TextBlock Classes="toolGroupCaption" Text="LIVE" />
            <StackPanel Orientation="Horizontal" Height="34" Spacing="8">
              <ToggleSwitch VerticalAlignment="Center" Margin="4,0,0,0" OnContent="" OffContent=""
                            IsChecked="{Binding IsLivePreview, Mode=TwoWay}"
                            ToolTip.Tip="Master-EQ: die Kurve wirkt sofort auf die Wiedergabe im Studio — zum Einstellen nach Gehör" />
              <TextBlock VerticalAlignment="Center" FontSize="12" Text="Master-EQ auf die Wiedergabe" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="toolGroup">
          <StackPanel>
            <TextBlock Classes="toolGroupCaption" Text="KURVE" />
            <StackPanel Orientation="Horizontal">
              <Button Classes="toolBtn" Command="{Binding ResetCommand}"
                      ToolTip.Tip="Alle vier Bänder auf 0 dB zurücksetzen">
                <ic:SymbolIcon Symbol="ArrowReset" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Margin="8,0,0,6" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
      </WrapPanel>
    </Border>

    <!-- ═══ EQ-Kurve ═══ -->
    <Border Grid.Row="2" Margin="0,14,0,0" Padding="12" CornerRadius="10" MinHeight="280"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <controls:EqCurveControl Bands="{Binding Bands}" SampleRate="{Binding SampleRate}" />
    </Border>

    <!-- ═══ Band-Legende ═══ -->
    <ItemsControl Grid.Row="3" Margin="0,12,0,0" ItemsSource="{Binding Bands}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="models:EqBand">
          <Border Margin="4" Padding="10,8" CornerRadius="8"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  ToolTip.Tip="Band in der Kurve ziehen: waagerecht ändert die Frequenz, senkrecht den Pegel">
            <StackPanel Orientation="Horizontal">
              <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center"
                      Background="{Binding ColorHex, Converter={StaticResource StringToBrush}}" />
              <StackPanel Margin="8,0,0,0">
                <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                           Text="{Binding Frequency, StringFormat='{}{0:F0} Hz'}" />
                <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding GainDb, StringFormat='{}{0:+0.0;-0.0;0} dB'}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
