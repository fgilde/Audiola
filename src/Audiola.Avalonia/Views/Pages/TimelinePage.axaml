<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:Audiola.Controls"
             xmlns:conv="using:Audiola.Avalonia.Converters"
             xmlns:vm="using:Audiola.ViewModels"
             x:Class="Audiola.Avalonia.Views.Pages.TimelinePage"
             x:DataType="vm:TimelineViewModel">

  <!-- Port von Audiola/Views/Pages/TimelinePage.xaml — die Mehrspur-Arbeitsfläche.
       Vier Quadranten: Zeitleiste oben fixiert, Spurköpfe links fixiert, Lanes scrollen beides. -->

  <UserControl.Resources>
    <conv:StringToBrushConverter x:Key="StringToBrush" />
    <conv:SecondsToWidthConverter x:Key="SecondsToWidth" />
    <conv:SecondsToMarginConverter x:Key="SecondsToMargin" />
    <conv:PixelsToLeftMarginConverter x:Key="PixelsToLeftMargin" />
    <conv:PanToTextConverter x:Key="PanToText" />
  </UserControl.Resources>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- Lineal und Spurköpfe scrollen nur mit; ihre Balken sind ausgeblendet („Hidden" malt
         sonst weiter die Laufspur und hinterlässt einen Strich neben den Spurköpfen). -->
    <Style Selector="ScrollViewer#HeaderScroll ScrollBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ScrollViewer#RulerScroll ScrollBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Ausgewählte Spur / ausgewählter Clip -->
    <Style Selector="Border.trackHeader.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource DawAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.clipBox.selected">
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>

    <!-- Spurname: sieht aus wie Text, ist aber ein Eingabefeld (Klick = umbenennen). -->
    <Style Selector="TextBox.trackName">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="21" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.trackName:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource DawHoverBrush}" />
    </Style>

    <!-- „…" öffnet dasselbe Menü wie der Rechtsklick — sonst findet es niemand. -->
    <Style Selector="Button.trackMenu">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="21" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource DawTextFaintBrush}" />
    </Style>
    <Style Selector="Button.trackMenu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DawHoverBrush}" />
    </Style>

    <!-- Mute/Solo/Aktiv: kleine Quadrate, eingeschaltet in der Farbe ihrer Bedeutung. -->
    <Style Selector="ToggleButton.msBtn">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource DawTextDimBrush}" />
    </Style>
    <Style Selector="ToggleButton.msBtn:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DawAccentSoftBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.msBtn:checked">
      <Setter Property="Foreground" Value="{DynamicResource DawAccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.msBtn.mute:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FF6B6B" />
    </Style>
    <Style Selector="ToggleButton.msBtn.mute:checked">
      <Setter Property="Foreground" Value="#FF8A8A" />
    </Style>
    <Style Selector="ToggleButton.msBtn.solo:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFB454" />
    </Style>
    <Style Selector="ToggleButton.msBtn.solo:checked">
      <Setter Property="Foreground" Value="#FFC978" />
    </Style>

    <!-- Fade-Griffe halten sich zurück, bis der Zeiger über dem Clip steht. -->
    <Style Selector="Border.clipBox Border.fadeGrip">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Background" Value="#66FFFFFF" />
      <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>
    <Style Selector="Border.clipBox:pointerover Border.fadeGrip">
      <Setter Property="Background" Value="#F2FFFFFF" />
    </Style>
    <!-- Clipname sitzt wie in jeder DAW oben links im Clip. -->
    <Style Selector="TextBlock.clipName">
      <Setter Property="Margin" Value="18,3,18,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="#B3FFFFFF" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- Verlaufs-Einträge -->
    <Style Selector="Button.historyEntry.current">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.historyEntry.undone">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="42,24,42,24" RowDefinitions="Auto,Auto,*,Auto">

    <!-- Kopf + Mix-Export (oben rechts, auf Höhe des Titels) -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0">
        <TextBlock Classes="dawPageTitle" Text="Studio" />
        <TextBlock Margin="0,2,0,0" IsVisible="{Binding !HasTracks}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Mehrspur-Arbeitsfläche — Audiodateien hierher ziehen, Stems übernehmen, Clips schneiden &amp; mischen." />
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding OpenSingAlongCommand}" IsEnabled="{Binding HasTracks}"
                ToolTip.Tip="Zum Song einsingen (Karaoke, Ton-Feedback) und als neue Spur übernehmen">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="Mic" /><TextBlock Text="Einsingen" />
          </StackPanel>
        </Button>
        <Button Classes="accent" Command="{Binding ExportMixCommand}" IsEnabled="{Binding HasTracks}"
                ToolTip.Tip="Den aktuellen Studio-Mix als Audiodatei speichern (WAV/MP3/…)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="ArrowExport" /><TextBlock Text="Mix exportieren" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ═══ Werkzeugleiste ═══
         Eine Zeile, alle Knöpfe gleich groß, Sinngruppen durch Striche getrennt. Schalter
         (Loop, Bereich, Raster, Mixer) sind ToggleButtons statt Kippschalter, damit die Zeile
         nicht auseinanderfällt. Darunter erscheint bei Auswahl die Clip-Zeile — in derselben
         Karte, damit das Layout beim Anklicken eines Clips nicht springt. -->
    <Border Grid.Row="1" Classes="toolbar">
      <StackPanel>
        <WrapPanel Orientation="Horizontal">

          <!-- Spuren anlegen -->
          <Border Classes="toolGroup">
            <StackPanel Orientation="Horizontal">
              <Button Classes="toolBtn accent" Command="{Binding AddAudioCommand}"
                      ToolTip.Tip="Audiodatei als Spur hinzufügen">
                <ic:SymbolIcon Symbol="Add" />
              </Button>
              <Button Classes="toolBtn" Command="{Binding AddEmptyTrackCommand}"
                      ToolTip.Tip="Leere Spur anlegen (Clips dorthin verschieben)">
                <ic:SymbolIcon Symbol="AddSquare" />
              </Button>
              <Button Classes="toolBtn" Command="{Binding ImportStemsCommand}"
                      ToolTip.Tip="Aktuelle Stems als Spuren übernehmen">
                <ic:SymbolIcon Symbol="Layer" />
              </Button>
              <Button Classes="toolBtn" Click="AddTts_Click"
                      ToolTip.Tip="Spur aus Text erzeugen (Sprache — Stimme im Dialog wählen: lokal oder ElevenLabs)">
                <ic:SymbolIcon Symbol="TextField" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Verlauf -->
          <Border Classes="toolGroup">
            <StackPanel Orientation="Horizontal">
              <Button Classes="toolBtn" Command="{Binding UndoCommand}" ToolTip.Tip="Rückgängig (Strg+Z)">
                <ic:SymbolIcon Symbol="ArrowUndo" />
              </Button>
              <Button Classes="toolBtn" Command="{Binding RedoCommand}" ToolTip.Tip="Wiederholen (Strg+Y)">
                <ic:SymbolIcon Symbol="ArrowRedo" />
              </Button>
              <ToggleButton Name="HistoryToggle" Classes="toolBtn"
                            IsChecked="{Binding ShowHistory, Mode=TwoWay}"
                            ToolTip.Tip="Verlauf: jeder Schritt ist anklickbar">
                <ic:SymbolIcon Symbol="History" />
                <ToggleButton.Flyout>
                  <Flyout Placement="Bottom">
                    <Border Width="320" MaxHeight="360" Padding="6">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="6,4,6,6" FontWeight="SemiBold"
                                   Text="Verlauf — Klick springt zum Stand" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:HistoryEntryViewModel">
                                <Button Classes="historyEntry" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Margin="0,1" Padding="8,5"
                                        BorderThickness="0" Background="Transparent"
                                        Classes.current="{Binding IsCurrent}" Classes.undone="{Binding IsUndone}"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.JumpToHistoryCommand}"
                                        CommandParameter="{Binding}">
                                  <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Circle" FontSize="10" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsCurrent}"
                                                   Foreground="{DynamicResource DawAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </DockPanel>
                    </Border>
                  </Flyout>
                </ToggleButton.Flyout>
              </ToggleButton>
            </StackPanel>
          </Border>

          <!-- Wiedergabe -->
          <Border Classes="toolGroup">
            <StackPanel Orientation="Horizontal">
              <Button Classes="toolBtn" Command="{Binding PlayPauseCommand}"
                      ToolTip.Tip="Abspielen / Pause (Leertaste)">
                <ic:SymbolIcon Symbol="Play" />
              </Button>
              <Button Classes="toolBtn" Command="{Binding StopCommand}" ToolTip.Tip="Stopp">
                <ic:SymbolIcon Symbol="Stop" />
              </Button>
              <ToggleButton Classes="toolBtn" IsChecked="{Binding LoopEnabled, Mode=TwoWay}"
                            ToolTip.Tip="Markierten Bereich in Schleife abspielen">
                <ic:SymbolIcon Symbol="ArrowRepeatAll" />
              </ToggleButton>
            </StackPanel>
          </Border>

          <!-- Bearbeiten -->
          <Border Classes="toolGroup">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Classes="toolBtn" IsChecked="{Binding RangeSelectMode, Mode=TwoWay}"
                            ToolTip.Tip="Auswahl-Werkzeug: in einer Spur ziehen markiert einen Bereich — Effekte und Schnitte wirken dann nur darauf">
                <ic:SymbolIcon Symbol="SelectObjectSkew" />
              </ToggleButton>
              <Button Classes="toolBtn" Command="{Binding SplitAtPlayheadCommand}"
                      ToolTip.Tip="Clip an der Abspielposition teilen">
                <ic:SymbolIcon Symbol="Cut" />
              </Button>
              <Button Classes="toolBtn" Command="{Binding CutRegionCommand}"
                      ToolTip.Tip="Markierten Bereich aus dem Clip herausschneiden">
                <ic:SymbolIcon Symbol="EraserSegment" />
              </Button>
              <Button Classes="toolBtn" Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="Clip löschen">
                <ic:SymbolIcon Symbol="Delete" />
              </Button>
              <Button Classes="toolBtn" Command="{Binding ClearSelectionCommand}"
                      ToolTip.Tip="Markierung aufheben">
                <ic:SymbolIcon Symbol="Dismiss" />
              </Button>
              <Button Classes="toolBtn" Command="{Binding ExportRangeCommand}"
                      ToolTip.Tip="Nur den markierten Bereich als Audiodatei speichern">
                <ic:SymbolIcon Symbol="Save" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Ansicht -->
          <Border Classes="toolGroup">
            <StackPanel Orientation="Horizontal">
              <Button Classes="toolBtn" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Auszoomen (Strg+Mausrad)">
                <ic:SymbolIcon Symbol="ZoomOut" />
              </Button>
              <Button Classes="toolBtn" Command="{Binding ZoomInCommand}" ToolTip.Tip="Einzoomen (Strg+Mausrad)">
                <ic:SymbolIcon Symbol="ZoomIn" />
              </Button>
              <Button Classes="toolBtn" Click="Fit_Click" ToolTip.Tip="Auf Song einpassen — ganzer Song sichtbar">
                <ic:SymbolIcon Symbol="ZoomFit" />
              </Button>
              <ic:SymbolIcon Symbol="AutoFitHeight" VerticalAlignment="Center" Margin="6,0,4,0"
                             Foreground="{DynamicResource DawTextFaintBrush}" />
              <Slider Width="72" VerticalAlignment="Center" Minimum="80" Maximum="320"
                      Value="{Binding LaneHeight, Mode=TwoWay}" ToolTip.Tip="Spurhöhe — größere Wellenform" />
              <ToggleButton Classes="toolBtn" Margin="6,0,2,0" IsChecked="{Binding SnapEnabled, Mode=TwoWay}"
                            ToolTip.Tip="Am Raster einrasten (das Raster wird dann auch angezeigt)">
                <ic:SymbolIcon Symbol="Grid" />
              </ToggleButton>
              <ComboBox Width="76" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center"
                        ItemsSource="{Binding GridOptions}" SelectedItem="{Binding GridSeconds, Mode=TwoWay}"
                        ToolTip.Tip="Rasterweite in Sekunden" />
            </StackPanel>
          </Border>

          <!-- Klang & Mixer -->
          <Border Classes="toolGroup last">
            <StackPanel Orientation="Horizontal">
              <Button Classes="toolBtn wide" Click="Variations_All_Click"
                      ToolTip.Tip="Variationen und Effekte auf das gesamte Projekt (alle Spuren) anwenden">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:SymbolIcon Symbol="Wand" /><TextBlock Text="Variationen" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <ToggleButton Classes="toolBtn wide" IsChecked="{Binding ShowMixer, Mode=TwoWay}"
                            ToolTip.Tip="Mixer mit Fadern und Pegeln unten ein-/ausblenden">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:SymbolIcon Symbol="Options" /><TextBlock Text="Mixer" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding IsSeparating}">
            <ProgressBar Width="60" Margin="8,0,0,0" VerticalAlignment="Center" IsIndeterminate="True" />
            <TextBlock Classes="toolValue" Margin="8,0,0,0" Text="{Binding SeparationStatus}" />
          </StackPanel>
        </WrapPanel>

        <!-- ═══ Clip-Zeile: nur bei Auswahl, in derselben Karte ═══ -->
        <Border Margin="0,6,0,0" Padding="0,7,0,1" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DawStrokeBrush}" IsVisible="{Binding HasSelectedClip}">
          <WrapPanel Orientation="Horizontal">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
              <Border Width="4" Height="18" CornerRadius="2" VerticalAlignment="Center"
                      Background="{Binding SelectedClip.Track.AccentColor, Converter={StaticResource StringToBrush}}" />
              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" MaxWidth="180"
                         TextTrimming="CharacterEllipsis" Text="{Binding SelectedClip.DisplayName}"
                         ToolTip.Tip="Ausgewählter Clip — die folgenden Regler wirken nur auf ihn" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Classes="toolLabel" Text="Pegel" />
              <Slider Width="96" VerticalAlignment="Center" Minimum="-24" Maximum="6"
                      Value="{Binding SelectedClip.GainDb, Mode=TwoWay}"
                      ToolTip.Tip="Lautstärke dieses Clips (−24 bis +6 dB)" />
              <TextBlock Classes="toolValue" Width="58" Margin="6,0,14,0"
                         Text="{Binding SelectedClip.GainDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Classes="toolLabel" Text="Fade-In" />
              <Slider Width="76" VerticalAlignment="Center" Minimum="0" Maximum="5"
                      Value="{Binding SelectedClip.FadeInSeconds, Mode=TwoWay}"
                      ToolTip.Tip="Einblenden — geht auch direkt am weißen Griff oben links im Clip" />
              <TextBlock Classes="toolValue" Width="46" Margin="6,0,14,0"
                         Text="{Binding SelectedClip.FadeInSeconds, StringFormat='{}{0:F2} s'}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Classes="toolLabel" Text="Fade-Out" />
              <Slider Width="76" VerticalAlignment="Center" Minimum="0" Maximum="5"
                      Value="{Binding SelectedClip.FadeOutSeconds, Mode=TwoWay}"
                      ToolTip.Tip="Ausblenden — geht auch direkt am weißen Griff oben rechts im Clip" />
              <TextBlock Classes="toolValue" Width="46" Margin="6,0,14,0"
                         Text="{Binding SelectedClip.FadeOutSeconds, StringFormat='{}{0:F2} s'}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Classes="toolBtn wide" Click="ClipVariations_Click"
                      ToolTip.Tip="Provider und Variationen wählen (Hall, Echo, Cleanup …) — wirkt auf den markierten Bereich, sonst auf den ganzen Clip">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:SymbolIcon Symbol="Wand" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding ClipEffectScope}" />
                </StackPanel>
              </Button>
              <Button Classes="toolBtn wide" Click="ClipVoiceChange_Click" IsEnabled="{Binding !IsVoiceChanging}"
                      ToolTip.Tip="Speech-to-Speech — Zielstimme im Dialog wählen (lokal oder ElevenLabs), aufnehmen oder hochladen. Timing und Betonung bleiben erhalten, nur die Klangfarbe wird ersetzt. Am besten auf einer isolierten Vocal-Spur.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:SymbolIcon Symbol="PersonVoice" />
                  <TextBlock VerticalAlignment="Center" Text="Stimme tauschen" />
                </StackPanel>
              </Button>
              <ProgressBar Width="50" Margin="6,0,0,0" VerticalAlignment="Center" IsIndeterminate="True"
                           IsVisible="{Binding IsVoiceChanging}" />
            </StackPanel>
          </WrapPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Hinweis ohne Spuren (vollflächiges Drop-Ziel) -->
    <Border Grid.Row="2" Background="Transparent" IsVisible="{Binding !HasTracks}"
            DragDrop.AllowDrop="True">
      <Border MaxWidth="520" Padding="44,36" VerticalAlignment="Center" HorizontalAlignment="Center"
              CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource DawStrokeStrongBrush}"
              Background="{DynamicResource DawPanelBrush}">
        <StackPanel>
          <Rectangle Height="3" Width="72" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Center"
                     Fill="{StaticResource BrandGradient}" />
          <ic:SymbolIcon Symbol="MusicNote2" FontSize="42" Margin="0,18,0,0" HorizontalAlignment="Center"
                         Foreground="{DynamicResource DawTextDimBrush}" />
          <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                     Text="Song hierher ziehen" />
          <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12.5"
                     Foreground="{DynamicResource DawTextFaintBrush}"
                     Text="Audio, mehrere Dateien oder ein ZIP — jede Datei wird eine Spur.&#x0a;Danach: Stems trennen, einsingen, mastern, exportieren." />
          <Button Margin="0,18,0,0" HorizontalAlignment="Center" Classes="accent" Command="{Binding AddAudioCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="FolderOpen" /><TextBlock Text="Datei öffnen…" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Border>

    <!-- Timeline (4-Quadranten: Ruler oben fixiert, Spurköpfe links fixiert) -->
    <Grid Grid.Row="2" Margin="0,14,0,0" IsVisible="{Binding HasTracks}"
          DragDrop.AllowDrop="True" ColumnDefinitions="222,*" RowDefinitions="26,*">

      <!-- Ecke oben links -->
      <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" Margin="2,0,0,5" FontSize="10"
                 FontWeight="SemiBold" Opacity="0.55"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="SPUREN" />

      <!-- Zeit-Lineal: oben fixiert, scrollt horizontal mit den Lanes -->
      <ScrollViewer Name="RulerScroll" Grid.Row="0" Grid.Column="1"
                    Background="{DynamicResource DawTimelineBrush}"
                    HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <!-- HorizontalAlignment=Left: passt der ganze Song in die Breite, zentriert der
             ScrollViewer den Inhalt sonst — die Zeitachse stünde dann versetzt zum Spurkopf. -->
        <Panel HorizontalAlignment="Left">
          <controls:TimelineRulerControl Name="Ruler" Cursor="Ibeam"
                                         PointerPressed="Ruler_PointerPressed" PointerMoved="Ruler_PointerMoved"
                                         PointerReleased="Ruler_PointerReleased"
                                         PixelsPerSecond="{Binding PixelsPerSecond}"
                                         DurationSeconds="{Binding DurationSeconds}" />
          <!-- Ziehbarer Playhead-Griff -->
          <Border Width="14" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left"
                  Margin="{Binding PlayheadX, Converter={StaticResource PixelsToLeftMargin}}"
                  Background="#FFFF5B5B" CornerRadius="3" Cursor="SizeWestEast"
                  ToolTip.Tip="Abspielposition ziehen"
                  PointerPressed="Playhead_PointerPressed" PointerMoved="Playhead_PointerMoved"
                  PointerReleased="Playhead_PointerReleased">
            <Border.RenderTransform>
              <TranslateTransform X="-7" />
            </Border.RenderTransform>
            <Path Data="M 4,6 L 10,6 L 7,12 Z" Fill="White"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ScrollViewer>

      <!-- ═══ Spurköpfe: links fixiert, scrollen vertikal mit den Lanes ═══
           Aufbau wie am Mischpult: Farbstreifen, Name mit Menüknopf, darunter Mute/Solo und
           der Fader, ganz rechts ein dünner Pegelbalken. Export/Löschen sind ins Menü gewandert,
           damit der Kopf auch bei kleiner Spurhöhe ruhig bleibt. -->
      <ScrollViewer Name="HeaderScroll" Grid.Row="1" Grid.Column="0"
                    VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tracks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:StemTrackViewModel">
              <Border Classes="trackHeader" Classes.selected="{Binding IsSelectedTrack}"
                      Height="{ReflectionBinding $parent[UserControl].DataContext.LaneHeight}"
                      Margin="0,0,8,0" CornerRadius="8" BorderThickness="1"
                      BorderBrush="{DynamicResource DawStrokeBrush}"
                      Background="{DynamicResource DawPanelBrush}"
                      PointerPressed="TrackHeader_PointerPressed">
                <Border.ContextMenu>
                  <!-- Kontextmenüs sind Popups außerhalb des visuellen Baums; Bindungen auf
                       Vorfahren greifen dort nicht. Deshalb Click-Handler, die die Spur über
                       den DataContext bzw. die Auswahl bestimmen. -->
                  <ContextMenu>
                    <MenuItem Header="Stems trennen → automatisch (erkennen + beste Qualität)"
                              Click="TrackSeparateAuto_Click">
                      <MenuItem.Icon><ic:SymbolIcon Symbol="Layer" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Stems trennen → 4 (schnell)" Click="TrackSeparate_Click" />
                    <MenuItem Header="Trennen (HQ · audio-separator)">
                      <MenuItem Header="RoFormer (Vocals / Instrumental)" Tag="roformer" Click="SeparateHq_Click" />
                      <MenuItem Header="Demucs 6 Stems (Gitarre / Klavier)" Tag="demucs6s" Click="SeparateHq_Click" />
                      <MenuItem Header="Karaoke (Lead / Background)" Tag="karaoke" Click="SeparateHq_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Variationen / Effekte…" Click="TrackVariations_Click">
                      <MenuItem.Icon><ic:SymbolIcon Symbol="Wand" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Stimme tauschen…" Click="TrackVoiceChange_Click">
                      <MenuItem.Icon><ic:SymbolIcon Symbol="PersonVoice" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Spur mastern…" Click="TrackMaster_Click">
                      <MenuItem.Icon><ic:SymbolIcon Symbol="Options" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Spur duplizieren" Click="TrackDuplicate_Click">
                      <MenuItem.Icon><ic:SymbolIcon Symbol="Copy" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Farbe">
                      <MenuItem Header="Blau" Tag="#5B8CFF" Click="TrackColor_Click" />
                      <MenuItem Header="Rot" Tag="#FF6B6B" Click="TrackColor_Click" />
                      <MenuItem Header="Orange" Tag="#FFB454" Click="TrackColor_Click" />
                      <MenuItem Header="Grün" Tag="#54D6A0" Click="TrackColor_Click" />
                      <MenuItem Header="Violett" Tag="#9B8CFF" Click="TrackColor_Click" />
                      <MenuItem Header="Pink" Tag="#FF8AD8" Click="TrackColor_Click" />
                      <MenuItem Header="Cyan" Tag="#6BD6FF" Click="TrackColor_Click" />
                      <MenuItem Header="Gelb" Tag="#D6C054" Click="TrackColor_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Spur exportieren…" Click="TrackExport_Click">
                      <MenuItem.Icon><ic:SymbolIcon Symbol="Save" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Spur löschen" Click="TrackDelete_Click">
                      <MenuItem.Icon><ic:SymbolIcon Symbol="Delete" /></MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Border.ContextMenu>

                <Grid ColumnDefinitions="4,*,4">
                  <!-- Farbstreifen = Spurfarbe, wie am Clip -->
                  <Border Grid.Column="0" CornerRadius="8,0,0,8"
                          Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}" />

                  <Grid Grid.Column="1" Margin="9,5,6,5" RowDefinitions="Auto,*,Auto">

                    <!-- Name + Menüknopf (öffnet dasselbe Menü wie der Rechtsklick) -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                      <Button DockPanel.Dock="Right" Classes="trackMenu" Click="TrackMenu_Click"
                              ToolTip.Tip="Alle Aktionen dieser Spur: Stems trennen, Effekte, Stimme, Farbe, exportieren, löschen">
                        <ic:SymbolIcon Symbol="MoreHorizontal" FontSize="16" />
                      </Button>
                      <TextBox Classes="trackName" Text="{Binding Name, Mode=TwoWay}"
                               ToolTip.Tip="Spurname — zum Umbenennen hineinklicken" />
                    </DockPanel>

                    <!-- Mute / Solo / aktiv + Fader mit Wert -->
                    <DockPanel Grid.Row="1" VerticalAlignment="Center" LastChildFill="True">
                      <ToggleButton DockPanel.Dock="Left" Classes="msBtn mute" Content="M"
                                    IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                    ToolTip.Tip="Stumm schalten" />
                      <ToggleButton DockPanel.Dock="Left" Classes="msBtn solo" Content="S"
                                    IsChecked="{Binding IsSolo, Mode=TwoWay}"
                                    ToolTip.Tip="Solo — nur diese Spur hören" />
                      <ToggleButton DockPanel.Dock="Left" Classes="msBtn" Margin="0,0,8,0"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    ToolTip.Tip="Spur aktiv — ausgeschaltete Spuren bleiben im Projekt, klingen aber nicht und werden nicht exportiert">
                        <ic:SymbolIcon Symbol="Power" FontSize="13" />
                      </ToggleButton>
                      <TextBlock DockPanel.Dock="Right" Classes="toolValue" Width="36"
                                 TextAlignment="Right" VerticalAlignment="Center"
                                 Text="{Binding Volume, StringFormat='{}{0:P0}'}" />
                      <Slider VerticalAlignment="Center" Minimum="0" Maximum="1.5"
                              Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                              ToolTip.Tip="Lautstärke dieser Spur" />
                    </DockPanel>

                    <!-- Panorama -->
                    <DockPanel Grid.Row="2" LastChildFill="True">
                      <TextBlock DockPanel.Dock="Left" Classes="toolLabel" Margin="0,0,6,0" Text="PAN" />
                      <TextBlock DockPanel.Dock="Right" Classes="toolValue" Width="36"
                                 TextAlignment="Right" VerticalAlignment="Center"
                                 Text="{Binding Pan, Converter={StaticResource PanToText}}" />
                      <Slider VerticalAlignment="Center" Minimum="-1" Maximum="1"
                              Value="{Binding Pan, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                              ToolTip.Tip="Panorama — links / Mitte / rechts" />
                    </DockPanel>
                  </Grid>

                  <!-- Pegel der laufenden Wiedergabe: zeigt ohne Mixer, welche Spur gerade klingt -->
                  <ProgressBar Grid.Column="2" Orientation="Vertical" Width="4" Margin="0,8"
                               Minimum="0" Maximum="1" Value="{Binding Level}"
                               Foreground="#54D6A0" Background="#0CFFFFFF"
                               ToolTip.Tip="Pegel dieser Spur" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Lanes: scrollen horizontal + vertikal und treiben die Synchronisation -->
      <ScrollViewer Name="LaneScroll" Grid.Row="1" Grid.Column="1"
                    Background="{DynamicResource DawTimelineBrush}"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <!-- VerticalAlignment=Top: das Raster endet unter der letzten Spur, statt die ganze
             leere Fläche zu streifen. -->
        <Panel Name="LanesArea" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
               Width="{Binding ContentWidth}"
               PointerPressed="Lanes_PointerPressed" PointerMoved="Lanes_PointerMoved"
               PointerReleased="Lanes_PointerReleased">
          <controls:TimelineGridControl PixelsPerSecond="{Binding PixelsPerSecond}"
                                        GridSeconds="{Binding GridSeconds}"
                                        IsHitTestVisible="False" IsVisible="{Binding SnapEnabled}" />
          <ItemsControl ItemsSource="{Binding Tracks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:StemTrackViewModel">
                <!-- Spurzeile in voller Timeline-Breite; Clips werden per Margin positioniert -->
                <Panel Height="{ReflectionBinding $parent[UserControl].DataContext.LaneHeight}"
                       Width="{ReflectionBinding $parent[UserControl].DataContext.ContentWidth}">
                  <!-- Hervorhebung der ausgewählten Spur -->
                  <Border IsHitTestVisible="False" Background="#142A6CFF"
                          BorderBrush="#5B8CFF" BorderThickness="3,0,0,0"
                          IsVisible="{Binding IsSelectedTrack}" />
                  <ItemsControl ItemsSource="{Binding Clips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Panel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ClipViewModel">
                        <Border Classes="clipBox" Classes.selected="{Binding IsSelected}"
                                VerticalAlignment="Stretch" HorizontalAlignment="Left"
                                CornerRadius="8" ClipToBounds="True" Cursor="SizeWestEast"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderThickness="2"
                                BorderBrush="{Binding AccentColor, Converter={StaticResource StringToBrush}}"
                                PointerPressed="Clip_PointerPressed" PointerMoved="Clip_PointerMoved"
                                PointerReleased="Clip_PointerReleased"
                                ToolTip.Tip="Ziehen zum Verschieben · Klick zum Auswählen · Rechtsklick für Aktionen">
                          <Border.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Variationen / Effekte…" Click="ClipVariations_Click" />
                              <MenuItem Header="Stimme tauschen…" Click="ClipVoiceChange_Click" />
                              <MenuItem Header="Transkribieren (Lyrics → LRC)">
                                <MenuItem Header="Lokal (Whisper)" Click="Transcribe_Click" />
                                <MenuItem Header="ElevenLabs" Click="TranscribeEleven_Click" />
                              </MenuItem>
                              <Separator />
                              <MenuItem Header="Markierten Bereich ausschneiden" Click="ClipCutRegion_Click" />
                              <MenuItem Header="Am Playhead teilen" Click="ClipSplit_Click" />
                              <MenuItem Header="Clip löschen" Click="ClipDelete_Click" />
                            </ContextMenu>
                          </Border.ContextMenu>
                          <Border.Margin>
                            <MultiBinding Converter="{StaticResource SecondsToMargin}">
                              <Binding Path="TimelineOffsetSeconds" />
                              <ReflectionBinding Path="$parent[UserControl].DataContext.PixelsPerSecond" />
                            </MultiBinding>
                          </Border.Margin>
                          <Border.Width>
                            <MultiBinding Converter="{StaticResource SecondsToWidth}">
                              <Binding Path="LengthSeconds" />
                              <ReflectionBinding Path="$parent[UserControl].DataContext.PixelsPerSecond" />
                            </MultiBinding>
                          </Border.Width>
                          <Panel>
                            <controls:WaveformControl Margin="0,14,0,2" Peaks="{Binding Peaks}"
                                                      WaveBrush="{Binding AccentColor, Converter={StaticResource StringToBrush}}" />
                            <controls:ClipFadeOverlay IsHitTestVisible="False"
                                                      FadeInSeconds="{Binding FadeInSeconds}"
                                                      FadeOutSeconds="{Binding FadeOutSeconds}"
                                                      PixelsPerSecond="{ReflectionBinding $parent[UserControl].DataContext.PixelsPerSecond}" />
                            <!-- Clipname oben, darunter erst die Wellenform -->
                            <TextBlock Classes="clipName" VerticalAlignment="Top" Text="{Binding DisplayName}" />
                            <!-- Fade-Griffe: an der Kante nach unten ziehen = Ein-/Ausblenden -->
                            <Border Classes="fadeGrip" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    ToolTip.Tip="Fade-In: nach unten ziehen"
                                    PointerPressed="FadeIn_PointerPressed" PointerMoved="Fade_PointerMoved"
                                    PointerReleased="Fade_PointerReleased" />
                            <Border Classes="fadeGrip" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    ToolTip.Tip="Fade-Out: nach unten ziehen"
                                    PointerPressed="FadeOut_PointerPressed" PointerMoved="Fade_PointerMoved"
                                    PointerReleased="Fade_PointerReleased" />
                          </Panel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Spur-eigener Auswahlbereich (nur auf dieser Spur sichtbar) -->
                  <Rectangle HorizontalAlignment="Left" VerticalAlignment="Stretch" IsHitTestVisible="False"
                             Fill="#403FA9FF" Stroke="White" StrokeThickness="1" StrokeDashArray="3,2"
                             IsVisible="{Binding IsSelectionTrack}">
                    <Rectangle.Margin>
                      <MultiBinding Converter="{StaticResource SecondsToMargin}">
                        <ReflectionBinding Path="$parent[UserControl].DataContext.SelectionStartSeconds" />
                        <ReflectionBinding Path="$parent[UserControl].DataContext.PixelsPerSecond" />
                      </MultiBinding>
                    </Rectangle.Margin>
                    <Rectangle.Width>
                      <MultiBinding Converter="{StaticResource SecondsToWidth}">
                        <ReflectionBinding Path="$parent[UserControl].DataContext.SelectionLengthSeconds" />
                        <ReflectionBinding Path="$parent[UserControl].DataContext.PixelsPerSecond" />
                      </MultiBinding>
                    </Rectangle.Width>
                  </Rectangle>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Globaler Auswahlbereich (vom Zeit-Lineal, über alle Spuren) -->
          <Rectangle HorizontalAlignment="Left" VerticalAlignment="Stretch" IsHitTestVisible="False"
                     Fill="#305B8CFF" Stroke="#805B8CFF" StrokeThickness="1"
                     IsVisible="{Binding HasGlobalSelection}">
            <Rectangle.Margin>
              <MultiBinding Converter="{StaticResource SecondsToMargin}">
                <Binding Path="SelectionStartSeconds" />
                <Binding Path="PixelsPerSecond" />
              </MultiBinding>
            </Rectangle.Margin>
            <Rectangle.Width>
              <MultiBinding Converter="{StaticResource SecondsToWidth}">
                <Binding Path="SelectionLengthSeconds" />
                <Binding Path="PixelsPerSecond" />
              </MultiBinding>
            </Rectangle.Width>
          </Rectangle>

          <!-- Playhead -->
          <Rectangle Width="2" Fill="#FFFF5B5B" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                     Margin="{Binding PlayheadX, Converter={StaticResource PixelsToLeftMargin}}"
                     IsHitTestVisible="False" />
        </Panel>
      </ScrollViewer>

    </Grid>

    <!-- Mixer-Panel (einblendbar) -->
    <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,8" CornerRadius="10"
            Background="{DynamicResource DawTimelineBrush}" IsVisible="{Binding ShowMixer}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tracks}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:StemTrackViewModel">
              <!-- Kanalzug: Farbe, Name, Fader mit Pegel daneben, Wert, Mute/Solo. Feste Höhe,
                   damit die Streifen nicht mit der freien Fläche mitwachsen. -->
              <Border Width="86" Height="196" Margin="0,0,8,0" CornerRadius="8"
                      BorderThickness="1" BorderBrush="{DynamicResource DawStrokeBrush}"
                      Background="{DynamicResource DawPanelBrush}">
                <Grid Margin="8,7" RowDefinitions="4,Auto,*,Auto,Auto">
                  <Border Grid.Row="0" CornerRadius="2" Margin="0,0,0,5"
                          Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}" />
                  <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" Text="{Binding Name}"
                             ToolTip.Tip="{Binding Name}" />
                  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                    <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" MinHeight="0"
                            Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                            ToolTip.Tip="Lautstärke dieser Spur" />
                    <ProgressBar Orientation="Vertical" Minimum="0" Maximum="1" Width="6" Margin="6,0,0,0"
                                 Value="{Binding Level}" Foreground="#54D6A0" Background="#14FFFFFF"
                                 ToolTip.Tip="Pegel dieser Spur" />
                  </StackPanel>
                  <TextBlock Grid.Row="3" Classes="toolValue" HorizontalAlignment="Center" Margin="0,0,0,5"
                             Text="{Binding Volume, StringFormat='{}{0:P0}'}" />
                  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <ToggleButton Classes="msBtn mute" Content="M" IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                  ToolTip.Tip="Stumm schalten" />
                    <ToggleButton Classes="msBtn solo" Content="S" Margin="0" IsChecked="{Binding IsSolo, Mode=TwoWay}"
                                  ToolTip.Tip="Solo — nur diese Spur hören" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
