<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:Audiola.Controls"
             xmlns:models="using:Audiola.Models"
             xmlns:services="using:Audiola.Services"
             xmlns:vm="using:Audiola.ViewModels"
             x:Class="Audiola.Avalonia.Views.Pages.VoicesPage"
             x:DataType="vm:VoicesViewModel">

  <!-- Port von Audiola/Views/Pages/VoicesPage.xaml. -->

  <UserControl.Styles>
    <!-- Grüner „installiert"-Badge -->
    <Style Selector="Border.installedBadge">
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource DawGreenBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionCaption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource DawTextFaintBrush}" />
      <Setter Property="Margin" Value="2,0,0,8" />
    </Style>
    <!-- GPU-Status wird grün, sobald CUDA aktiv ist. -->
    <Style Selector="TextBlock.gpuStatus">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.gpuStatus.cudaActive">
      <Setter Property="Foreground" Value="{DynamicResource DawGreenBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Margin="42,24,42,24" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
      <TextBlock Classes="dawPageTitle" Text="Stimmen" />
      <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="Eigene Stimmen erstellen und verwalten — lokal (CUDA/CPU) oder mit ElevenLabs. Stimmen gelten projektübergreifend." />

      <!-- ————— Engine-Leiste ————— -->
      <Border Margin="0,18,0,0" Padding="16,12" CornerRadius="10"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <StackPanel Grid.Column="0" Margin="0,0,26,0">
            <TextBlock Classes="sectionCaption" Text="RECHEN-GERÄT" />
            <ComboBox Width="130" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,26,0">
            <TextBlock Classes="sectionCaption" Text="WHISPER (TRANSKRIPTION)" />
            <ComboBox Width="130" ItemsSource="{Binding WhisperModels}" SelectedItem="{Binding WhisperModel, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,16,3">
            <StackPanel Orientation="Horizontal">
              <ic:SymbolIcon Symbol="DeveloperBoard" FontSize="14" VerticalAlignment="Center"
                             Foreground="{DynamicResource DawTextDimBrush}" />
              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                         Classes="gpuStatus" Classes.cudaActive="{Binding CudaActive}" Text="{Binding GpuStatus}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <ProgressBar Width="40" Margin="0,0,8,0" IsIndeterminate="True" VerticalAlignment="Center"
                           IsVisible="{Binding IsBusy}" />
              <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Status}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
            <Button Command="{Binding CheckGpuCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="ArrowSync" /><TextBlock Text="GPU prüfen" />
              </StackPanel>
            </Button>
            <Button Command="{Binding InstallCudaTorchCommand}"
                    ToolTip.Tip="PyTorch mit CUDA-Unterstützung installieren (GPU-Beschleunigung)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="ArrowDownload" /><TextBlock Text="CUDA-Torch" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Margin="0,20,0,0" ColumnDefinitions="7*,24,5*">

        <!-- ————— LINKS: Eigene Stimme erstellen + Liste ————— -->
        <StackPanel Grid.Column="0">
          <TextBlock Classes="sectionCaption" Text="NEUE STIMME ERSTELLEN" />
          <Border Padding="18" CornerRadius="12"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
              <!-- 1 · Name / Modell / Sprache -->
              <Grid ColumnDefinitions="*,8,170,8,64">
                <TextBox Grid.Column="0" Watermark="Name der Stimme" Text="{Binding NewName, Mode=TwoWay}" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding Models}" DisplayMemberBinding="{Binding Name}"
                          SelectedItem="{Binding NewModel, Mode=TwoWay}" ToolTip.Tip="Voice-Modell" />
                <TextBox Grid.Column="4" Watermark="de" Text="{Binding NewLanguage, Mode=TwoWay}"
                         ToolTip.Tip="Sprache (z. B. de, en)" />
              </Grid>

              <!-- 2 · Mikrofon (mit Live-Pegel) -->
              <TextBlock Classes="sectionCaption" Margin="2,16,0,6" Text="MIKROFON — der Balken zeigt dein Signal" />
              <controls:MicSelectorControl HorizontalAlignment="Left"
                                           DeviceNumber="{Binding RecordDeviceNumber, Mode=TwoWay}" />

              <!-- 3 · Aufnehmen oder Datei -->
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button MinWidth="150" Command="{Binding ToggleRecordCommand}" Classes.danger="{Binding IsRecording}"
                        Content="{Binding RecordButtonLabel}" HorizontalContentAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Margin="12,0" FontSize="12"
                           Foreground="{DynamicResource DawTextFaintBrush}" Text="oder" />
                <Button Command="{Binding BrowseSampleCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon Symbol="FolderOpen" /><TextBlock Text="Sample wählen…" />
                  </StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" MaxWidth="220"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding SamplePath, TargetNullValue='noch kein Sample'}" />
              </StackPanel>

              <!-- 4 · Erstellen -->
              <Button Margin="0,16,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Classes="accent" Command="{Binding CreateProfileCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:SymbolIcon Symbol="PersonVoice" /><TextBlock Text="Stimme erstellen" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <TextBlock Classes="sectionCaption" Margin="2,22,0,8" Text="DEINE STIMMEN" />
          <TextBox Margin="0,0,0,10" Watermark="Vorschau-Text — wird bei ▶ mit der Stimme gesprochen"
                   Text="{Binding PreviewText, Mode=TwoWay}" />
          <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:VoiceProfile">
                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0"
                            Background="{DynamicResource DawAccentSoftBrush}">
                      <ic:SymbolIcon Symbol="PersonVoice" FontSize="16"
                                     Foreground="{DynamicResource DawAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Description}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                      <Button ToolTip.Tip="Vorschau abspielen"
                              Command="{ReflectionBinding $parent[UserControl].DataContext.PreviewProfileCommand}"
                              CommandParameter="{Binding}">
                        <ic:SymbolIcon Symbol="Play" />
                      </Button>
                      <Button ToolTip.Tip="Stimme löschen"
                              Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteProfileCommand}"
                              CommandParameter="{Binding}">
                        <ic:SymbolIcon Symbol="Delete" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ————— RECHTS: Modelle ————— -->
        <StackPanel Grid.Column="2">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="sectionCaption" Text="VOICE-MODELLE" />
            <Button Margin="10,-6,0,0" Padding="6,2" ToolTip.Tip="Liste aktualisieren"
                    Command="{Binding LoadModelsCommand}">
              <ic:SymbolIcon Symbol="ArrowSync" />
            </Button>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="services:LocalVoiceModel">
                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <Border Classes="installedBadge" IsVisible="{Binding Installed}">
                          <TextBlock Text="installiert" FontSize="10" Foreground="White" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock FontSize="11" Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                 Text="{Binding SizeText, StringFormat='≈ {0}'}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="Modell herunterladen"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.DownloadModelCommand}"
                            CommandParameter="{Binding}">
                      <ic:SymbolIcon Symbol="ArrowDownload" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
            <TextBlock Classes="sectionCaption" Margin="2,0,0,0" Text="WHISPER-MODELLE" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Top" FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{Binding WhisperModel, StringFormat='aktiv: {0}'}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding WhisperModelsList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="services:LocalVoiceModel">
                <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <Border Classes="installedBadge" IsVisible="{Binding Installed}">
                        <TextBlock Text="installiert" FontSize="10" Foreground="White" />
                      </Border>
                      <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                 Text="{Binding SizeText, StringFormat='≈ {0}'}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="Modell herunterladen"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.DownloadModelCommand}"
                            CommandParameter="{Binding}">
                      <ic:SymbolIcon Symbol="ArrowDownload" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
