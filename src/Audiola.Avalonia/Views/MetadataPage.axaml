<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Audiola.Avalonia.Views.MetadataPage">
 <ScrollViewer><StackPanel Margin="32" MaxWidth="920" Spacing="14"><TextBlock FontSize="28" FontWeight="SemiBold" Text="Project metadata" /><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="Metadata is stored in the portable project and included in compatible exports." /><Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="16"><Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10"><TextBlock Text="Title" /><TextBox Grid.Column="1" Text="{Binding Parent.MetadataTitle}" /><TextBlock Grid.Row="1" Text="Artist" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Parent.MetadataArtist}" /><TextBlock Grid.Row="2" Text="Album" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Parent.MetadataAlbum}" /><TextBlock Grid.Row="3" Text="Genre" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Parent.MetadataGenre}" /></Grid></Border><Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="LYRICS / LRC" /><TextBox Height="180" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Parent.MetadataLyrics}" /></StackPanel></Border><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Choose cover…" Command="{Binding Parent.ChooseCoverCommand}" /><TextBlock VerticalAlignment="Center" Foreground="{StaticResource DawTextDimBrush}" Text="{Binding Parent.MetadataCoverStatus}" /><Button Classes="accent" Content="Save project" Command="{Binding Parent.SaveProjectCommand}" IsEnabled="{Binding Parent.HasTracks}" /></StackPanel></StackPanel></ScrollViewer>
</UserControl>
