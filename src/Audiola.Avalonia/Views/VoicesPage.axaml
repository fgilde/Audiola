<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Audiola.Avalonia.Views.VoicesPage">
 <ScrollViewer><StackPanel Margin="32" MaxWidth="1080" Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="Voices" /><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="Manage licensed local voice profiles and render speech into the timeline." /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Refresh models" Command="{Binding Parent.LoadVoiceModelsCommand}" /><Button Classes="accent" Content="Add profile…" Command="{Binding Parent.AddVoiceProfileCommand}" /></StackPanel></Grid><TextBlock Foreground="{StaticResource DawAccentLightBrush}" Text="{Binding Parent.VoiceEngineMessage}" TextWrapping="Wrap" />
 <Grid ColumnDefinitions="*,*" ColumnSpacing="14"><Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel Spacing="9"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DawTextFaintBrush}" Text="TEXT TO SPEECH" /><ComboBox ItemsSource="{Binding Parent.VoiceProfiles}" SelectedItem="{Binding Parent.SelectedVoiceProfile}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox AcceptsReturn="True" Height="100" TextWrapping="Wrap" Text="{Binding Parent.VoiceText}" /><Grid ColumnDefinitions="Auto,*,Auto"><TextBlock VerticalAlignment="Center" Text="{Binding Parent.VoiceSpeed, StringFormat='Speed  {0:0.00}×'}" /><Slider Grid.Column="1" Margin="10,0" Minimum=".5" Maximum="1.5" Value="{Binding Parent.VoiceSpeed}" /><Button Grid.Column="2" Classes="accent" Content="Generate WAV…" Command="{Binding Parent.SynthesizeVoiceCommand}" IsEnabled="{Binding Parent.CanSynthesizeVoice}" /></Grid><TextBlock FontSize="11" Foreground="{StaticResource DawTextFaintBrush}" Text="{Binding Parent.VoiceStatus}" /></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel Spacing="8"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DawTextFaintBrush}" Text="STORED PROFILES" /><ItemsControl ItemsSource="{Binding Parent.VoiceProfiles}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource DawCardBrush}" CornerRadius="5" Padding="10" Margin="0,2"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock FontSize="11" Foreground="{StaticResource DawTextFaintBrush}" Text="{Binding Description}" /></StackPanel><Button Grid.Column="1" Content="Remove" Command="{Binding DataContext.Parent.RemoveVoiceProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid>
 <Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel Spacing="8"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DawTextFaintBrush}" Text="LOCAL MODEL CATALOG" /><ItemsControl ItemsSource="{Binding Parent.VoiceModels}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,3"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock FontSize="11" Foreground="{StaticResource DawTextFaintBrush}" Text="{Binding Description}" /></StackPanel><Button Grid.Column="1" Content="Install" Command="{Binding DataContext.Parent.DownloadVoiceModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding DataContext.Parent.VoiceEngineAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></ScrollViewer>
</UserControl>
