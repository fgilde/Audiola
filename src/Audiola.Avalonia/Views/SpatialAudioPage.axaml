<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Audiola.Avalonia.Views.SpatialAudioPage">
 <ScrollViewer><StackPanel Margin="32" MaxWidth="1100" Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="Spatial audio" /><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="Place project tracks in an immersive binaural or surround render." /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><ComboBox Width="90" ItemsSource="{Binding Parent.SpatialLayouts}" SelectedItem="{Binding Parent.SelectedSpatialLayoutName}" /><Button Content="Auto-arrange" Command="{Binding Parent.AutoArrangeSpatialCommand}" /></StackPanel></Grid>
 <Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DawTextFaintBrush}" Text="SOURCES / POSITIONING" /><ItemsControl ItemsSource="{Binding Parent.SpatialSources}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,7,0,0" Background="{StaticResource DawCardBrush}" CornerRadius="6" Padding="12"><Grid ColumnDefinitions="145,*,*,*,Auto" ColumnSpacing="12"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><CheckBox Content="Mute" IsChecked="{Binding Muted}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock FontSize="11" Text="{Binding AzimuthDeg, StringFormat='Azimuth  {0:0}°'}" /><Slider Minimum="-180" Maximum="180" Value="{Binding AzimuthDeg}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock FontSize="11" Text="{Binding ElevationDeg, StringFormat='Elevation  {0:0}°'}" /><Slider Minimum="0" Maximum="90" Value="{Binding ElevationDeg}" /></StackPanel><StackPanel Grid.Column="3"><TextBlock FontSize="11" Text="{Binding Distance, StringFormat='Distance  {0:0.00}'}" /><Slider Minimum=".3" Maximum="3" Value="{Binding Distance}" /></StackPanel><TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource DawAccentLightBrush}" Text="{Binding GainDb, StringFormat='{}{0:+0.0;-0.0;0} dB'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
 <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="accent" Content="Export binaural WAV…" Command="{Binding Parent.ExportBinauralCommand}" /><Button Content="Export surround WAV…" Command="{Binding Parent.ExportSurroundCommand}" /><TextBlock VerticalAlignment="Center" Foreground="{StaticResource DawTextDimBrush}" Text="{Binding Parent.SpatialStatus}" /></StackPanel><TextBlock FontSize="11" Foreground="{StaticResource DawTextFaintBrush}" Text="{Binding Parent.SpatialPreviewMessage}" TextWrapping="Wrap" /></StackPanel></ScrollViewer>
</UserControl>
