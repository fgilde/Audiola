<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Audiola.Avalonia.Views.ProvenancePage">
 <ScrollViewer><StackPanel Margin="32" MaxWidth="1000" Spacing="14"><TextBlock FontSize="28" FontWeight="SemiBold" Text="Provenance &amp; analysis" /><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="Read-only inspection of embedded provenance and generator markers." /><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="accent" Content="Analyze active track" Command="{Binding Parent.AnalyzeCurrentTrackCommand}" IsEnabled="{Binding Parent.HasAudio}" /><Button Content="Choose file…" Command="{Binding Parent.AnalyzeFileCommand}" /></StackPanel><Border Background="{StaticResource DawCardBrush}" CornerRadius="6" Padding="10"><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="{Binding Parent.ProvenanceStatus}" /></Border><ItemsControl ItemsSource="{Binding Parent.ProvenanceFindings}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,3"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /><TextBlock FontSize="11" Foreground="{StaticResource DawAccentLightBrush}" Text="{Binding Category}" /><TextBlock TextWrapping="Wrap" Text="{Binding Detail}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" Text="{Binding Parent.ProvenanceAssessment}" /><TextBlock FontSize="11" Foreground="{StaticResource DawTextFaintBrush}" Text="{Binding Parent.C2paHelp}" /><TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" Text="{Binding Parent.ProvenanceRaw}" /></StackPanel></ScrollViewer>
</UserControl>
