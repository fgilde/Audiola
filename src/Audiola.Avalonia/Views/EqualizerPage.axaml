<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Audiola.Avalonia.Controls" x:Class="Audiola.Avalonia.Views.EqualizerPage">
  <ScrollViewer><StackPanel Margin="32" MaxWidth="1080" Spacing="14">
    <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="Equalizer" /><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="Shape the shared mastering chain for the active source." /></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Content="Reset chain" Command="{Binding Parent.ResetMasteringCommand}" /></Grid>
    <Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><Grid RowDefinitions="Auto,180,Auto" RowSpacing="10"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DawTextFaintBrush}" Text="{Binding Parent.ActiveTrack.FileName, TargetNullValue='NO ACTIVE TRACK'}" /><Border Grid.Row="1" Background="{StaticResource DawBackgroundBrush}" CornerRadius="5" Padding="10"><controls:WaveformView Peaks="{Binding Parent.ActiveTrack.Peaks}" Progress="{Binding Parent.PlaybackProgress}" SeekCommand="{Binding Parent.SeekCommand}" WaveBrush="{StaticResource DawAccentLightBrush}" /></Border><Slider Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding Parent.PlaybackProgress, Mode=TwoWay}" IsEnabled="{Binding Parent.IsTransportAvailable}" /></Grid></Border>
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
      <Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel Spacing="7"><TextBlock FontWeight="SemiBold" Text="LOW SHELF" /><TextBlock Text="{Binding Parent.LowShelfGainDb, StringFormat='Gain  {0:+0.0;-0.0;0} dB'}" /><Slider Minimum="-12" Maximum="12" Value="{Binding Parent.LowShelfGainDb, Mode=TwoWay}" /></StackPanel></Border>
      <Border Grid.Column="1" Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel Spacing="7"><TextBlock FontWeight="SemiBold" Text="MID BAND" /><TextBlock Text="{Binding Parent.MidGainDb, StringFormat='Gain  {0:+0.0;-0.0;0} dB'}" /><Slider Minimum="-12" Maximum="12" Value="{Binding Parent.MidGainDb, Mode=TwoWay}" /></StackPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel Spacing="7"><TextBlock FontWeight="SemiBold" Text="HIGH SHELF" /><TextBlock Text="{Binding Parent.HighShelfGainDb, StringFormat='Gain  {0:+0.0;-0.0;0} dB'}" /><Slider Minimum="-12" Maximum="12" Value="{Binding Parent.HighShelfGainDb, Mode=TwoWay}" /><CheckBox Content="High-pass filter" IsChecked="{Binding Parent.HighPassEnabled}" /><Slider Minimum="20" Maximum="180" Value="{Binding Parent.HighPassHz, Mode=TwoWay}" /></StackPanel></Border>
    </Grid><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="accent" Content="Export EQ result…" Command="{Binding Parent.ExportMasterCommand}" IsEnabled="{Binding Parent.HasAudio}" /><TextBlock VerticalAlignment="Center" Foreground="{StaticResource DawTextDimBrush}" Text="{Binding Parent.MasteringStatus}" /></StackPanel>
  </StackPanel></ScrollViewer>
</UserControl>
