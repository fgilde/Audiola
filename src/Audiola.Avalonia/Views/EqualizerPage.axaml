<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Audiola.Avalonia.Controls"
             x:Class="Audiola.Avalonia.Views.EqualizerPage">
  <ScrollViewer>
    <StackPanel Margin="40" MaxWidth="900" Spacing="14">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="Equalizer" />
      <TextBlock Foreground="#B9C2D0" Text="Offline EQ controls feed the Core mastering processor. Export applies the exact displayed chain." />
      <Border Background="#20232B" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <controls:WaveformView Height="170" Peaks="{Binding Parent.ActiveTrack.Peaks}"
                                 Progress="{Binding Parent.PlaybackProgress}" SeekCommand="{Binding Parent.SeekCommand}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
            <StackPanel>
              <TextBlock Text="{Binding Parent.LowShelfGainDb, StringFormat='Low shelf: {0:+0.0;-0.0;0} dB'}" />
              <Slider Minimum="-12" Maximum="12" Value="{Binding Parent.LowShelfGainDb, Mode=TwoWay}" />
              <TextBlock Text="{Binding Parent.MidGainDb, StringFormat='Mid band: {0:+0.0;-0.0;0} dB'}" />
              <Slider Minimum="-12" Maximum="12" Value="{Binding Parent.MidGainDb, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Parent.HighShelfGainDb, StringFormat='High shelf: {0:+0.0;-0.0;0} dB'}" />
              <Slider Minimum="-12" Maximum="12" Value="{Binding Parent.HighShelfGainDb, Mode=TwoWay}" />
              <CheckBox Content="High-pass filter" IsChecked="{Binding Parent.HighPassEnabled, Mode=TwoWay}" />
              <TextBlock Text="{Binding Parent.HighPassHz, StringFormat='High-pass: {0:0} Hz'}" />
              <Slider Minimum="20" Maximum="180" Value="{Binding Parent.HighPassHz, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Reset" Command="{Binding Parent.ResetMasteringCommand}" />
        <Button Content="Export EQ result…" Command="{Binding Parent.ExportMasterCommand}" />
      </StackPanel>
      <TextBlock Foreground="#9CA8BA" Text="{Binding Parent.MasteringStatus}" />
      <TextBlock Foreground="#9CA8BA" TextWrapping="Wrap"
                 Text="Use the shared transport to audition the active source and click its waveform to seek. Export applies the displayed offline EQ chain." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
