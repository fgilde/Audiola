<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Audiola.Avalonia.Views.AboutPage">
 <ScrollViewer><StackPanel Margin="40" MaxWidth="820" Spacing="16"><StackPanel Spacing="4"><TextBlock FontSize="36" FontWeight="Bold" Text="Audiola" /><TextBlock Foreground="{StaticResource DawAccentLightBrush}" Text="MODERN AUDIO STUDIO" /><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="{Binding Parent.VersionText}" /></StackPanel><Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel Spacing="9"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Native Avalonia desktop host" /><TextBlock TextWrapping="Wrap" Text="Audiola combines portable multitrack projects, waveform editing, mastering, spatial audio, variations, voice workflows, and provenance inspection in one DAW-inspired workspace." /><TextBlock Foreground="{StaticResource DawTextFaintBrush}" Text="{Binding Parent.PlatformText}" /></StackPanel></Border><Border Background="{StaticResource DawCardBrush}" CornerRadius="7" Padding="16"><TextBlock Foreground="{StaticResource DawTextDimBrush}" TextWrapping="Wrap" Text="Optional local tools such as Demucs, voice synthesis, and c2patool remain explicitly availability-checked. Unsupported operations stay disabled." /></Border><TextBlock Foreground="{StaticResource DawTextFaintBrush}" Text="github.com/fgilde/Audiola" /></StackPanel></ScrollViewer>
</UserControl>
