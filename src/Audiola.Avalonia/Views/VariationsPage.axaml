<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Audiola.Avalonia.Views.VariationsPage">
  <ScrollViewer>
    <StackPanel Margin="40" MaxWidth="840" Spacing="14">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="Variations" />
      <TextBlock Foreground="#B9C2D0" TextWrapping="Wrap"
                 Text="Generate a new audio asset using a deterministic Core studio effect. The source track remains untouched." />
      <ItemsControl ItemsSource="{Binding Parent.Variations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#20232B" CornerRadius="8" Padding="14" Margin="0,3">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                  <TextBlock FontSize="12" Foreground="#9CA8BA" Text="{Binding Description}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Select"
                        Command="{Binding DataContext.Parent.SelectVariationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Background="#20232B" CornerRadius="8" Padding="16">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock VerticalAlignment="Center" Text="{Binding Parent.SelectedVariation.Name, TargetNullValue='Select a variation'}" />
          <Button Content="Apply selected variation and export…" Command="{Binding Parent.ApplyVariationCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
