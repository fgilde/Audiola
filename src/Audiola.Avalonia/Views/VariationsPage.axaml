<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Audiola.Avalonia.Views.VariationsPage">
 <ScrollViewer><StackPanel Margin="32" MaxWidth="920" Spacing="14"><TextBlock FontSize="28" FontWeight="SemiBold" Text="Klangvariation" /><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="Create a new audio asset while preserving the source unchanged." /><ItemsControl ItemsSource="{Binding Parent.Variations}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,3"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock FontSize="12" Foreground="{StaticResource DawTextDimBrush}" Text="{Binding Description}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="Select" Command="{Binding DataContext.Parent.SelectVariationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Background="{StaticResource DawCardBrush}" CornerRadius="7" Padding="12"><Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Text="{Binding Parent.SelectedVariation.Name, TargetNullValue='Select a variation'}" /><Button Grid.Column="1" Classes="accent" Content="Apply and export…" Command="{Binding Parent.ApplyVariationCommand}" IsEnabled="{Binding Parent.HasAudio}" /></Grid></Border></StackPanel></ScrollViewer>
</UserControl>
