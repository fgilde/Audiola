<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Audiola.Avalonia.Views.EvaluationPage">
 <ScrollViewer><StackPanel Margin="32" MaxWidth="960" Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="Evaluation harness" /><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="Evaluate a labeled detector CSV without modifying source audio." /></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Classes="accent" Content="Load CSV…" Command="{Binding Parent.LoadEvaluationCsvCommand}" /></Grid><Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel><TextBlock Text="{Binding Parent.EvaluationThreshold, StringFormat='Decision threshold  {0:0.00}'}" /><Slider Minimum="0" Maximum="1" Value="{Binding Parent.EvaluationThreshold}" /><TextBlock FontSize="11" Foreground="{StaticResource DawTextFaintBrush}" Text="{Binding Parent.EvaluationStatus}" /></StackPanel></Border><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel Spacing="6"><TextBlock FontWeight="SemiBold" Text="CONFUSION MATRIX" /><TextBlock Text="{Binding Parent.TruePositives, StringFormat='True positives  {0}'}" /><TextBlock Text="{Binding Parent.FalsePositives, StringFormat='False positives  {0}'}" /><TextBlock Text="{Binding Parent.TrueNegatives, StringFormat='True negatives  {0}'}" /><TextBlock Text="{Binding Parent.FalseNegatives, StringFormat='False negatives  {0}'}" /><TextBlock Foreground="{StaticResource DawTextFaintBrush}" Text="{Binding Parent.EvaluationSkipped, StringFormat='Skipped  {0}'}" /></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel Spacing="6"><TextBlock FontWeight="SemiBold" Text="METRICS" /><TextBlock Text="{Binding Parent.Accuracy, StringFormat='Accuracy  {0}'}" /><TextBlock Text="{Binding Parent.Precision, StringFormat='Precision  {0}'}" /><TextBlock Text="{Binding Parent.Recall, StringFormat='Recall  {0}'}" /><TextBlock Text="{Binding Parent.F1, StringFormat='F1  {0}'}" /><TextBlock Text="{Binding Parent.Specificity, StringFormat='Specificity  {0}'}" /><TextBlock Text="{Binding Parent.FalsePositiveRate, StringFormat='False-positive rate  {0}'}" /><TextBlock Text="{Binding Parent.FalseNegativeRate, StringFormat='False-negative rate  {0}'}" /></StackPanel></Border></Grid></StackPanel></ScrollViewer>
</UserControl>
