<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:Audiola.Avalonia.Views.Dialogs"
        xmlns:vm="using:Audiola.ViewModels"
        x:Class="Audiola.Avalonia.Views.Dialogs.VoiceSwapDialog"
        x:DataType="vm:VoiceSourceViewModel"
        Title="Stimme tauschen"
        Width="560" Height="600"
        MinWidth="420" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DawBgBrush}"
        Foreground="{DynamicResource DawTextBrush}">

  <!-- Port von Audiola/Views/Dialogs/VoiceSwapDialog.xaml. -->

  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock Grid.Row="0" Margin="18,16,18,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               Text="Speech-to-Speech über ElevenLabs: Performance/Timing/Betonung (auch Gesang) bleiben, nur die Klangfarbe wird zur Zielstimme. Am besten auf einer isolierten Vocal-Spur. Zielstimme wählen, aufnehmen oder als Datei hochladen." />

    <ScrollViewer Grid.Row="1" Margin="14,10,14,0" VerticalScrollBarVisibility="Auto">
      <dialogs:VoiceSourcePicker />
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,8,18,16" Spacing="8">
      <ProgressBar Width="50" Margin="0,0,4,0" VerticalAlignment="Center" IsIndeterminate="True"
                   IsVisible="{Binding IsResolving}" />
      <Button Content="Abbrechen" Click="Cancel_Click" IsEnabled="{Binding !IsResolving}" />
      <Button Content="Übernehmen" Classes="accent" Click="Ok_Click" IsEnabled="{Binding !IsResolving}" />
    </StackPanel>
  </Grid>
</Window>
