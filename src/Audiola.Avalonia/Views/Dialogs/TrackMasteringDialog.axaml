<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:controls="using:Audiola.Controls"
        xmlns:vm="using:Audiola.ViewModels"
        x:Class="Audiola.Avalonia.Views.Dialogs.TrackMasteringDialog"
        x:DataType="vm:MasteringViewModel"
        Title="Spur mastern"
        Width="820" Height="760"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DawBgBrush}"
        Foreground="{DynamicResource DawTextBrush}">

  <!-- Port von Audiola/Views/Dialogs/TrackMasteringDialog.xaml: dasselbe Mastering-Panel wie auf
       der Seite, Quelle ist die gewählte Spur (solo). Aktionen liegen im Dialog-Footer. -->

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
      <controls:MasteringPanel Margin="18,10,18,10" ShowActions="False" />
    </ScrollViewer>

    <Border Grid.Row="1" Padding="18,12" Background="{DynamicResource DawPanelBrush}"
            BorderBrush="{DynamicResource DawStrokeBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <!-- Sekundär: gemasterte Spur als Datei exportieren -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Command="{Binding ExportCommand}"
                  ToolTip.Tip="Die gemasterte Spur als Audiodatei speichern (ohne die Spur im Studio zu ändern)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="Save" /><TextBlock Text="Als Datei exportieren" />
            </StackPanel>
          </Button>
          <ProgressBar Width="60" Margin="12,0,0,0" VerticalAlignment="Center" IsIndeterminate="True"
                       IsVisible="{Binding IsBusy}" />
        </StackPanel>
        <!-- Primär: Anwenden / Abbrechen -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Classes="accent" Command="{Binding ApplyToTrackCommand}"
                  ToolTip.Tip="Spur mastern und im Studio ersetzen (Strg+Z macht es rückgängig)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="CheckmarkCircle" /><TextBlock Text="Anwenden" />
            </StackPanel>
          </Button>
          <Button Content="Abbrechen" Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
