<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Audiola.Avalonia.Views.MasteringPage">
  <ScrollViewer><StackPanel Margin="32" MaxWidth="1000" Spacing="14"><TextBlock FontSize="28" FontWeight="SemiBold" Text="Mastering" /><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="EQ, compression, loudness normalization, and safe WAV export." />
    <Border Background="{StaticResource DawPanelBrush}" BorderBrush="{StaticResource DawStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16"><Grid ColumnDefinitions="*,*" ColumnSpacing="24">
      <StackPanel Spacing="9"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DawTextFaintBrush}" Text="DYNAMICS" /><TextBlock Text="Preset" /><ComboBox ItemsSource="{Binding Parent.MasteringProfiles}" SelectedItem="{Binding Parent.SelectedMasteringProfile}" /><CheckBox Content="Enable compressor" IsChecked="{Binding Parent.CompressorEnabled}" /><TextBlock Text="{Binding Parent.ThresholdDb, StringFormat='Threshold  {0:0} dB'}" /><Slider Minimum="-40" Maximum="-4" Value="{Binding Parent.ThresholdDb, Mode=TwoWay}" /><TextBlock Text="{Binding Parent.Ratio, StringFormat='Ratio  {0:0.0}:1'}" /><Slider Minimum="1" Maximum="10" Value="{Binding Parent.Ratio, Mode=TwoWay}" /></StackPanel>
      <StackPanel Grid.Column="1" Spacing="9"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DawTextFaintBrush}" Text="DELIVERY" /><CheckBox Content="Normalize loudness" IsChecked="{Binding Parent.NormalizeLoudness}" /><TextBlock Text="{Binding Parent.TargetLufs, StringFormat='Target  {0:0} LUFS'}" /><Slider Minimum="-24" Maximum="-6" Value="{Binding Parent.TargetLufs, Mode=TwoWay}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Measure LUFS" Command="{Binding Parent.MeasureLoudnessCommand}" IsEnabled="{Binding Parent.HasAudio}" /><Button Classes="accent" Content="Export master…" Command="{Binding Parent.ExportMasterCommand}" IsEnabled="{Binding Parent.HasAudio}" /></StackPanel><Button Content="Reset settings" Command="{Binding Parent.ResetMasteringCommand}" /></StackPanel>
    </Grid></Border><Border Background="{StaticResource DawCardBrush}" CornerRadius="6" Padding="10"><TextBlock Foreground="{StaticResource DawTextDimBrush}" Text="{Binding Parent.MasteringStatus}" TextWrapping="Wrap" /></Border>
  </StackPanel></ScrollViewer>
</UserControl>
