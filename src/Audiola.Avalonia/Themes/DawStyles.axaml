<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia">

  <!-- ============================================================
       Shell-Styles der DAW-Oberfläche — Gegenstück zu den benannten
       Styles in Audiola/Themes/DawTheme.xaml. Avalonia adressiert
       Styles über Selektoren, deshalb tragen die Views eine Klasse
       (Classes="dawPanel") statt Style="{StaticResource DawPanelStyle}".
       ============================================================ -->

  <!-- Panel: die Grundfläche aller Docks/Karten. -->
  <Style Selector="Border.dawPanel">
    <Setter Property="Background" Value="{DynamicResource DawPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DawStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Abschnitts-Überschrift in Panels (kleine, gedimmte Caption). -->
  <Style Selector="TextBlock.dawCaption">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DawTextFaintBrush}" />
  </Style>

  <!-- Transport-Zeitanzeige: große Monospace-Ziffern wie im Studio. -->
  <Style Selector="TextBlock.dawTimeDisplay">
    <Setter Property="FontFamily" Value="Consolas,Menlo,DejaVu Sans Mono,monospace" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DawTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Statusleisten-Text. -->
  <Style Selector="TextBlock.dawStatusText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource DawTextFaintBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Seiten-Titel: großer Kopf jeder Seite im Marken-Farbverlauf. -->
  <Style Selector="TextBlock.dawPageTitle">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrandGradient}" />
  </Style>

  <!-- Werkzeug-Button der Icon-Rail (links): quadratisch, ruhig, klarer Hover. -->
  <Style Selector="RadioButton.dawRail">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,2" />
    <!-- Die Rail ist breiter als der Knopf; ohne das sitzt er am linken Rand. -->
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource DawTextDimBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" CornerRadius="8" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.dawRail:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource DawHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.dawRail:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource DawTextBrush}" />
  </Style>
  <Style Selector="RadioButton.dawRail:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource DawAccentSoftBrush}" />
  </Style>
  <Style Selector="RadioButton.dawRail:checked">
    <Setter Property="Foreground" Value="{DynamicResource DawAccentBrush}" />
  </Style>
  <Style Selector="RadioButton.dawRail:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Icon-Button der Werkzeugleisten (Transport, Kopfzeilen): wie Rail, aber ohne Auswahlzustand. -->
  <Style Selector="Button.dawIcon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource DawTextDimBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" CornerRadius="8" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.dawIcon:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource DawHoverBrush}" />
  </Style>
  <Style Selector="Button.dawIcon:pressed /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource DawAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.dawIcon:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Dock-Tab (unteres Panel): flacher Tab mit Akzent-Unterstreichung. -->
  <Style Selector="RadioButton.dawDockTab">
    <Setter Property="Foreground" Value="{DynamicResource DawTextFaintBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" Padding="12,6" CornerRadius="6,6,0,0" Background="Transparent">
          <StackPanel>
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
            <Rectangle Name="underline" Height="2" Margin="0,4,0,0"
                       RadiusX="1" RadiusY="1" Fill="Transparent" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.dawDockTab:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource DawTextDimBrush}" />
  </Style>
  <Style Selector="RadioButton.dawDockTab:checked">
    <Setter Property="Foreground" Value="{DynamicResource DawTextBrush}" />
  </Style>
  <Style Selector="RadioButton.dawDockTab:checked /template/ Rectangle#underline">
    <Setter Property="Fill" Value="{StaticResource BrandGradient}" />
  </Style>

  <!-- Primär-Button (Play, „Übernehmen" …): Avalonias accent-Klasse zieht die Systemfarbe,
       hier stattdessen der Studio-Akzent wie in der WPF-Fassung. -->
  <!-- Der Fluent-Standard zieht die Systemakzentfarbe im Template; deshalb hier direkt am
       ContentPresenter überschreiben, sonst gewinnt die Windows-Farbe des Nutzers. -->
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DawAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DawAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DawAccentLightBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DawAccentLightBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DawAccentBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- Warn-/Aufnahme-Button (REC läuft): rot statt Akzentblau. -->
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DawRecBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DawRecBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Schalter ohne „On/Off"-Beschriftung (die WPF-Fassung zeigt nur den Schalter). -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>

  <!-- Menüleiste und Menüs in Studio-Farben (Avalonias Fluent-Standard ist heller). -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource DawTextDimBrush}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Menu > MenuItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource DawTextBrush}" />
  </Style>

  <!-- Scrollbalken: schlank und halbtransparent wie in der WPF-Fassung. -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource DawScrollTrackBrush}" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource DawScrollThumbBrush}" />
  </Style>

  <!-- ═══════════ Werkzeugleiste: eine Zeile, flache Icon-Knöpfe, Trenner ═══════════
       Vorbild sind die Leisten in Reaper/Audition: dicht gesetzte Icons gleicher Größe,
       durch dünne Striche in Sinngruppen geteilt. Keine Kästen, keine Überschriften — die
       Erklärung steckt im Tooltip, den jeder Knopf zwingend hat. -->
  <Style Selector="Border.toolbar">
    <Setter Property="Margin" Value="0,14,0,0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource DawPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DawStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Gruppe: Knöpfe einer Aufgabe, rechts durch einen Strich abgesetzt. -->
  <Style Selector="Border.toolGroup">
    <Setter Property="Padding" Value="0,0,9,0" />
    <Setter Property="Margin" Value="0,0,9,0" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource DawStrokeStrongBrush}" />
  </Style>
  <Style Selector="Border.toolGroup.last">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- Überschrift nur noch, wo eine Leiste sie wirklich braucht. -->
  <Style Selector="TextBlock.toolGroupCaption">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,0,0,3" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- Werkzeug-Knopf: quadratisch, flach, Hover als Fläche. Gilt auch für ToggleButton,
       damit Schalter (Loop, Raster, Mixer) nicht aus der Zeile fallen. -->
  <Style Selector=":is(Button).toolBtn">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource DawTextDimBrush}" />
    <!-- Werkzeug-Knöpfe nehmen den Fokus nicht an: sonst löst die Leertaste den zuletzt
         geklickten Knopf aus statt die Wiedergabe. -->
    <Setter Property="Focusable" Value="False" />
  </Style>
  <!-- Knopf mit Beschriftung (z. B. „Variationen"): gleiche Höhe, nur breiter. -->
  <Style Selector=":is(Button).toolBtn.wide">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector=":is(Button).toolBtn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector=":is(Button).toolBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DawHoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector=":is(Button).toolBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DawAccentSoftBrush}" />
  </Style>
  <!-- Eingeschalteter Schalter trägt den Akzent — der Zustand ist so ohne Text ablesbar. -->
  <Style Selector="ToggleButton.toolBtn:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DawAccentSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.toolBtn:checked">
    <Setter Property="Foreground" Value="{DynamicResource DawAccentBrush}" />
  </Style>
  <Style Selector=":is(Button).toolBtn.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DawAccentSoftBrush}" />
  </Style>
  <Style Selector=":is(Button).toolBtn.accent">
    <Setter Property="Foreground" Value="{DynamicResource DawAccentBrush}" />
  </Style>
  <Style Selector=":is(Button).toolBtn:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Beschriftung eines Reglers in der Leiste (klein, gedimmt, vor dem Regler). -->
  <Style Selector="TextBlock.toolLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0,6,0" />
    <Setter Property="Foreground" Value="{DynamicResource DawTextFaintBrush}" />
  </Style>
  <!-- Zahlenwert in Leisten und Spurköpfen: Monospace, damit nichts springt. -->
  <Style Selector="TextBlock.toolValue">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource DawTextDimBrush}" />
  </Style>

  <!-- Abschnitts-Überschrift in Versalien (RECHEN-GERÄT, DEINE STIMMEN, …). -->
  <Style Selector="TextBlock.sectionCaption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,0,0,8" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- ═══════════ Leerzustand: Icon, Satz, nächster Schritt ═══════════
       Statt einer leeren Fläche sagt die Seite, was sie braucht und wo man es bekommt. -->
  <Style Selector="StackPanel.emptyState">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Spacing" Value="10" />
    <Setter Property="MaxWidth" Value="460" />
  </Style>
  <Style Selector="StackPanel.emptyState > ic|SymbolIcon">
    <Setter Property="FontSize" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource DawTextFaintBrush}" />
  </Style>
  <Style Selector="StackPanel.emptyState > TextBlock.title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.emptyState > TextBlock.hint">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- Regler-Zeile: Bezeichnung links, aktueller Wert rechts, Regler darunter. -->
  <Style Selector="Grid.sliderRow > TextBlock.value">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
</Styles>
