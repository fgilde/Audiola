<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource DawBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DawTextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DawTextBrush}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource DawCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DawStrokeBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DawTextBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="11,6" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{StaticResource DawHoverBrush}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource DawAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DawAccentLightBrush}" />
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="Background" Value="{StaticResource DawCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DawStrokeBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DawTextBrush}" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource DawTextDimBrush}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource DawTextBrush}" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource DawTextDimBrush}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="3,2" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DawHoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DawAccentSoftBrush}" />
  </Style>
</Styles>
